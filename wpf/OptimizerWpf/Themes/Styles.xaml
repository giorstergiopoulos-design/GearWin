<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Κλασικό μενού - ΔΙΟΡΘΩΣΗ (χρήστης ανέφερε με screenshot: άσπρο/ανοιχτόχρωμο φόντο στο dark
         mode): το native Menu/MenuItem submenu Popup στο WPF κρατάει ΠΑΝΤΑ το δικό του προεπιλεγμένο
         (ανοιχτόχρωμο) φόντο ό,τι DynamicResource κι αν έχει το Foreground - ακριβώς το ίδιο πρόβλημα
         που είχε λυθεί νωρίτερα για το ComboBox του theme picker (βλ. MainWindow.xaml). Λύση εδώ:
         πλήρες retemplate και για τα δύο "ρόλους" (TopLevelHeader = τα "Εργαλεία/Προβολή/..." πάνω
         στη γραμμή menu, SubmenuItem = οι επιλογές μέσα στο dropdown) με ρητό CardBgBrush στο Popup
         και TextBrush/SubTextBrush παντού, ώστε να ακολουθεί σωστά και τα 21 θέματα + light/dark. Το
         SubmenuItem template δείχνει πλέον ΚΑΙ το InputGestureText (Ctrl+1 κ.λπ.) σε ξεχωριστή στήλη
         δεξιά - πριν υπήρχε μόνο ως ιδιότητα χωρίς οπτική αναπαράσταση στο default template. -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid>
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource AppCornerRadius}" Padding="10,6">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                </Border>
                                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}" Padding="3">
                                        <StackPanel IsItemsHost="True"/>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BtnHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource AppCornerRadius}">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="4,6"/>
                                    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource SubTextBrush}"
                                               Margin="16,6,10,6" VerticalAlignment="Center" FontSize="11"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BtnHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Windows 11-style flat scrollbar (ρητό αίτημα χρήστη: "τα scroll bars είναι των κλασικων
         windows και οχι των 11") - το default WPF ScrollBar template ΕΙΝΑΙ το παλιό, χοντρό,
         γκρι στυλ με βελάκια πάνω/κάτω ανεξάρτητα από οποιοδήποτε DynamicResource θέμα εφαρμόζεται
         αλλού· εφαρμόζεται αυτόματα ΠΑΝΤΟΥ (κάθε ScrollViewer το χρησιμοποιεί εσωτερικά μέσω
         implicit style lookup) χωρίς να χρειάζεται retemplate του ίδιου του ScrollViewer. Λεπτή,
         διάφανη λωρίδα + στρογγυλεμένο "thumb" - χωρίς βελάκια, όπως τα σύγχρονα scrollbars των
         Windows 11. -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource CardBorderBrush}" CornerRadius="4" Margin="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="12"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Width" Value="Auto"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Card container: rounded border, CardBg fill - used by every metric/section card across tabs.
         ΝΕΟ - roadmap "Ελαφριά ανύψωση κάρτας στο hover" - ρητό DropShadowEffect (Opacity=0 by
         default, καμία ορατή επίδραση/σχεδόν μηδενικό κόστος όταν το ποντίκι δεν είναι από πάνω) +
         διακριτική ανύψωση 2px, ίδιο DropShadowEffect μοτίβο με το ήδη υπάρχον HardwareChipIcon. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value><TranslateTransform X="0" Y="0"/></Setter.Value>
        </Setter>
        <!-- ΔΙΟΡΘΩΣΗ (χρήστης επέμενε ότι το bug ΕΞΑΚΟΛΟΥΘΟΥΣΕ μετά την πρώτη "διόρθωση" - φάρδεμα του
             κενού 8px->16px ανάμεσα σε διαδοχικές κάρτες ΔΕΝ αρκούσε): το Direction="270" ρίχνει τη
             σκιά ΚΑΘΕΤΑ ΠΡΟΣ ΤΑ ΚΑΤΩ (ΟΧΙ διαγώνια), και η προηγούμενη τιμή BlurRadius=16+
             ShadowDepth=5 έφτανε ΠΑΝΩ από 16px σε πραγματική εμβέλεια (ShadowDepth + BlurRadius = 21px
             ως το σημείο μηδενικής αδιαφάνειας) - δηλαδή η σκιά της κάθε κάρτας σε hover ξεπερνούσε
             ΠΑΝΤΑ το τυπικό 16px κενό και "μπλεκόταν" οπτικά με την επόμενη κάρτα, ανεξάρτητα από πόσο
             μεγάλο ήταν το κενό μεταξύ τους. Μειώθηκε σε BlurRadius=8+ShadowDepth=3 (εμβέλεια ~11px,
             ΠΑΝΤΑ μικρότερη από το ελάχιστο 16px κενό ανάμεσα σε ΚΑΘΕ ζεύγος καρτών στην εφαρμογή) -
             η ανύψωση σε hover παραμένει ορατή, απλά χωρίς να διαρρέει στην επόμενη κάρτα. -->
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0" BlurRadius="8" ShadowDepth="3" Direction="270"/>
            </Setter.Value>
        </Setter>
        <!-- ΔΙΟΡΘΩΣΗ (χρήστης επέμενε, με νέο screenshot, ότι το bug ΕΞΑΚΟΛΟΥΘΟΥΣΕ και μετά το
             μείωμα BlurRadius/ShadowDepth παραπάνω) - το zoomed screenshot αποκάλυψε ότι ΔΕΝ ήταν καν
             θολή σκιά (θα ήταν γκρι/μαύρη, διάχυτη) αλλά δύο μικρά, ΜΠΛΕ, κοφτά τμήματα στρογγυλής
             γωνίας "αιωρούμενα" ανάμεσα στις δύο κάρτες - γνωστό WPF rendering artifact όταν ένα
             στοιχείο έχει ΤΑΥΤΟΧΡΟΝΑ RenderTransform (το animated TranslateTransform.Y παραπάνω για το
             "ανασήκωμα" σε hover) ΚΑΙ Effect (το DropShadowEffect) χωρίς CacheMode: το WPF composition
             layer αφήνει μερικές φορές ένα stale/partial bitmap του Effect από το ΠΡΟΗΓΟΥΜΕΝΟ frame
             (πριν τη μετατόπιση) χωρίς σωστή επανα-ακύρωση, με τις στρογγυλές γωνίες να είναι το πιο
             ορατό υπόλειμμα. BitmapCache αναγκάζει το WPF να ξανααποδώσει σε cached bitmap ΚΑΘΕ φορά
             που αλλάζει το RenderTransform, αντί να βασίζεται σε ενδιάμεση κατάσταση σύνθεσης - καθιερωμένη
             διόρθωση για ακριβώς αυτή την κατηγορία artifact (Effect+RenderTransform στο ίδιο στοιχείο). -->
        <Setter Property="CacheMode">
            <Setter.Value><BitmapCache/></Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)" To="0.32" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ΝΕΟ - roadmap "Virtualization σε μεγάλες λίστες" - ListProcesses/ListServices/
         ListScheduledTasks/ListFirewallRules ήταν απλά ItemsControl (StackPanel, ΚΑΘΕ στοιχείο
         δημιουργείται/measure/arrange ταυτόχρονα) - με εκατοντάδες στοιχεία (πλήρης λίστα
         διεργασιών/κανόνων firewall σε φορτωμένο σύστημα) η αρχική απόδοση υποβαθμιζόταν αισθητά.
         ListBox virtualization είναι ενεργό ΕΞ ΟΡΙΣΜΟΥ (VirtualizingStackPanel.IsVirtualizing=True
         default από .NET 4.5+) - το στυλ εδώ απλά αφαιρεί την οπτική "επιλογή" (background/χρώμα)
         αφού αυτές είναι λίστες ΜΟΝΟ για προβολή/ενέργειες ανά γραμμή (toggle/κουμπί), όχι επιλογή. -->
    <Style x:Key="VirtualizedListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section title inside a card (icon + bold text row) -->
    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style x:Key="SubTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ΝΕΟ - HealthCheckWindow's "pills" γύρω από το κεντρικό εικονίδιο (ρητό αίτημα χρήστη - βλ.
         PC Manager's Health Check γραφικό). Ξεκινάνε όλα σε ουδέτερη κατάσταση· το code-behind
         εναλλάσσει BorderBrush/Background σε accent όταν το αντίστοιχο πραγματικό scan τρέχει, ίδιο
         μοτίβο DynamicResource με όλα τα υπόλοιπα themed στοιχεία της εφαρμογής. -->
    <Style x:Key="HealthCheckPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="12,7"/>
    </Style>

    <Style x:Key="HealthCheckPillTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <!-- Τιμή θερμοκρασίας στα πλακίδια απόδοσης (ρητό αίτημα χρήστη: "τα εικονίδια... δεν είναι
         ευδιακριτα στο dark mode") - το SubTextStyle είναι σκόπιμα χαμηλής αντίθεσης (δευτερεύον
         κείμενο), ακατάλληλο για μια τιμή που ο χρήστης θέλει να διαβάζει εύκολα. Πλήρες TextBrush
         (όχι dim SubText) + μεγαλύτερο/έντονο μέγεθος. -->
    <Style x:Key="TempValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <!-- Tab strip pill button - ToggleButton so exactly one can read as "checked"/selected via the
         RadioButton-style GroupName trick (ToggleButton doesn't support grouping natively, so
         MainWindow.xaml.cs unchecks the others manually on click - see TabButton_Click). -->
    <Style x:Key="TabPillStyle" TargetType="RadioButton">
        <Setter Property="GroupName" Value="MainTabs"/>
        <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="{DynamicResource AppCornerRadius}" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TabSelectBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BtnHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ίδιο pill-στυλ με το TabPillStyle (RadioButton) παραπάνω, αλλά για πραγματικό TabItem/
         TabControl (ρητό αίτημα χρήστη: "οι καρτέλες στις ρυθμίσεις εξακολουθούν να μην είναι pills
         και να είναι λευκές" - το TabItem χωρίς δικό του Style/Template χρησιμοποιεί το προεπιλεγμένο
         chrome των Windows, άσπρο ανεξαρτήτως θέματος). Χρησιμοποιείται ως TabControl.ItemContainerStyle. -->
    <Style x:Key="PillTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bg" CornerRadius="{DynamicResource AppCornerRadius}" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Content" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TabSelectBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BtnHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat, rounded button - matches the app's BtnDefault/BtnHover flat button look -->
    <Style x:Key="FlatButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BtnDefaultBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- ΔΙΟΡΘΩΣΗ (Windows Classic skin): CornerRadius+BorderThickness/Brush πλέον
                         DynamicResource - 0/αόρατο σε όλα τα μοντέρνα θέματα (καμία οπτική αλλαγή εκεί),
                         αλλά τετράγωνο+ορατό περίγραμμα (απλοποιημένη προσέγγιση classic bevel) όταν
                         είναι ενεργό το "Windows Classic" - βλ. ThemeManager.Apply(). -->
                    <Border x:Name="Bg" CornerRadius="{DynamicResource AppCornerRadius}" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource AppButtonBorderBrush}" BorderThickness="{DynamicResource AppButtonBorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BtnHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent (primary/CTA) button - solid accent fill -->
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Theme-aware row for the theme picker popup's ListBox (see MainWindow.xaml BtnThemePicker) -
         explicit Foreground/hover/selected backgrounds so it never depends on Windows' own system
         colors, which is what made the previous ComboBox-based picker's text invisible.
         ΔΙΟΡΘΩΣΗ (χρήστης ανέφερε: "δεν φαίνεται ποιο θέμα είναι επιλεγμένο"): η προηγούμενη εκδοχή
         είχε μόνο μια αμυδρή αλλαγή φόντου (TabSelectBrush) στο επιλεγμένο στοιχείο, πολύ κοντινή
         οπτικά στο hover χρώμα ώστε να ξεχωρίζει με μια ματιά. Τώρα το επιλεγμένο στοιχείο παίρνει
         ΚΑΙ μια συμπαγή κάθετη λωρίδα AccentBrush αριστερά ΚΑΙ ένα ✓ δεξιά ΚΑΙ έντονη γραφή -
         τρία ανεξάρτητα οπτικά στοιχεία, ώστε να είναι αδύνατο να περάσει απαρατήρητο σε
         οποιοδήποτε από τα 21 θέματα. -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" CornerRadius="{DynamicResource AppCornerRadius}" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AccentBar" Grid.Column="0" Width="4" CornerRadius="2" Background="Transparent" Margin="-10,-6,6,-6"/>
                            <ContentPresenter x:Name="Content" Grid.Column="1"/>
                            <TextBlock x:Name="Check" Grid.Column="2" Text="&#x2713;" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BtnHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TabSelectBrush}"/>
                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Content" Property="TextElement.FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ΔΙΟΡΘΩΣΗ (χρήστης ανέφερε με screenshot: "στην έναρξη δοκιμής το dropdown είναι δύσμορφο" -
         το ComboBox της Δοκιμής Ταχύτητας Δίσκου, αλλά αφορά ΚΑΙ τα άλλα 3 ComboBox της εφαρμογής,
         AddContextMenuDialog/AppearanceSettingsWindow×2): ΔΕΝ υπήρχε ΚΑΝΕΝΑ style για ComboBox σε
         όλη την εφαρμογή - χρησιμοποιούσε το προεπιλεγμένο, "κλασικό Windows" chrome (λευκό φόντο,
         διαφορετική γραμματοσειρά/περίγραμμα) που δεν ακολουθεί κανένα από τα 21 θέματα, ίδιο
         bug-class με το ScrollBar/MenuItem/TabItem παραπάνω. Implicit styles (χωρίς x:Key) ώστε να
         εφαρμόζονται αυτόματα ΠΑΝΤΟΥ χωρίς να χρειάζεται Style="..." σε κάθε ComboBox ξεχωριστά -
         το ComboBoxItem template επαναχρησιμοποιεί το ίδιο οπτικό λεξιλόγιο με το ListBoxItem/
         MenuItem popup παραπάνω (CardBgBrush popup, BtnHoverBrush/TabSelectBrush states). -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" CornerRadius="{DynamicResource AppCornerRadius}" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BtnHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TabSelectBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource BtnDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- ΔΙΟΡΘΩΣΗ (χρήστης ανέφερε, με screenshot: "στο θέμα εφαρμογής είναι πολύ
                             λευκό" - επιβεβαιώθηκε ζωντανά, RGB(221,221,221) αντί για το αναμενόμενο
                             σκούρο BtnDefault π.χ. (45,45,45) στο Windows 11 Fluent Dark) - αυτό το
                             εσωτερικό ToggleButton δεν είχε ΠΟΤΕ δικό του Background/BorderBrush/
                             BorderThickness ορισμένα εδώ· το {Binding ..., RelativeSource=
                             {RelativeSource TemplatedParent}} μέσα στο ToggleButton.Template παρακάτω
                             δείχνει στο ΙΔΙΟ το ToggleButton (όχι στο ComboBox), οπότε έπαιρνε πάντα το
                             προεπιλεγμένο, ανοιχτόχρωμο σύστημα-θέμα φόντο ενός απλού ToggleButton -
                             ΠΟΤΕ δεν έφτανε σε αυτό το σκούρο θεματικό χρώμα του ComboBox, σε ΚΑΝΕΝΑ
                             θέμα/dark ή light. Τα 3 TemplateBinding εδώ (δείχνουν ΤΩΡΑ στο ίδιο το
                             ComboBox) περνάνε επιτέλους τις πραγματικές θεματικές τιμές παρακάτω. -->
                        <ToggleButton x:Name="ToggleButton"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press" Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ToggleBg" CornerRadius="{DynamicResource AppCornerRadius}"
                                            Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToggleBg" Property="Background" Value="{DynamicResource BtnHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" Margin="10,0,26,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Path Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource SubTextBrush}" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}" Padding="3"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- On/off pill switch - matches the custom on/off toggles Optimizer.ps1 owner-draws throughout
         every tab (dozens of tweak rows). Shared here since it'll be reused by every ported tab, not
         just Optimization. -->
    <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- ΔΙΟΡΘΩΣΗ (χρήστης έστειλε screenshot: οι διακόπτες στη λίστα Πρόσθετων
                         Λειτουργιών "δεν φαίνονται σωστά" στο Light Mode) - το Track's BtnDefaultBrush
                         σε αρκετά ανοιχτόχρωμα θέματα είναι σχεδόν λευκό (π.χ. "Windows Vista Aero
                         Light Blue" -> RGB 212,233,247), και ο λευκός κύκλος (Knob, Fill="White")
                         πάνω του γινόταν σχεδόν αόρατος - πολύ χαμηλή αντίθεση. Ρητό BorderBrush στο
                         Track ΚΑΙ Stroke στο Knob (και τα δύο CardBorderBrush - το ίδιο χρώμα που η
                         εφαρμογή ήδη χρησιμοποιεί ΠΑΝΤΟΥ ειδικά για να ξεχωρίζει από το φόντο) δίνουν
                         ΠΑΝΤΑ ένα ορατό περίγραμμα γύρω από το κουμπί/κύκλο, ανεξάρτητα από το πόσο
                         κοντά είναι τα χρώματα γεμίσματος σε κάθε συγκεκριμένο θέμα. -->
                    <Border x:Name="Track" CornerRadius="12" Background="{DynamicResource BtnDefaultBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White"
                                 Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1"
                                 HorizontalAlignment="Left" Margin="2,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Track" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ΝΕΟ - ρητό αίτημα χρήστη: "ο οδηγός χρήσης με εικονίδια GIF" (κινούμενα εικονίδια, βλ.
         HelpWindow.xaml) - παλμός Opacity+μέγεθος σε ΚΑΘΕ εικονίδιο ξεχωριστά (χωρίς
         Storyboard.TargetName - EventTrigger σε Loaded ξεκινά μια τοπική, "ανώνυμη" instance για
         κάθε ένα από τα δεκάδες instances του HeaderGlyphIcon στον οδηγό, αντί για ένα ΚΟΙΝΟ
         named-target Storyboard όπως το ήδη υπάρχον PulseAttentionDotStoryboard - αυτό εδώ μοτίβο
         χρειάζεται όποτε το ΙΔΙΟ animation πρέπει να εφαρμοστεί σε πολλαπλά, ανώνυμα instances του
         ίδιου DataTemplate/επαναλαμβανόμενου στοιχείου).
         ΔΙΟΡΘΩΣΗ (χρήστης ανέφερε: "πώς βλέπω τα GIF;" - δεν το πρόσεχε καθόλου) - η αρχική εκδοχή
         (μόνο Opacity 1→0.5 σε 1.3s) επιβεβαιώθηκε ΤΕΧΝΙΚΑ ότι έτρεχε (μέτρηση pixel-brightness στο
         χρόνο), αλλά ήταν οπτικά πολύ αδιόρατη σε εικονίδια 15px, ειδικά μέσα σε μια πυκνή σελίδα
         κειμένου - ο χρήστης ΔΕΝ την έβλεπε καν σε κανονική χρήση. Τώρα ΣΥΝΔΥΑΣΜΟΣ Opacity (1→0.25,
         πολύ πιο έντονη διαφορά) ΚΑΙ μεγέθους (ScaleTransform 1→1.35, ένα ξεκάθαρο "ανάσασμα") σε
         γρηγορότερο κύκλο (0.8s ανά κατεύθυνση αντί για 1.3s) - αδύνατο πλέον να μη φανεί. -->
    <Style x:Key="PulsingIconContainerStyle" TargetType="Border">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8"/>
                        <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.35" Duration="0:0:0.8"/>
                        <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.35" Duration="0:0:0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
