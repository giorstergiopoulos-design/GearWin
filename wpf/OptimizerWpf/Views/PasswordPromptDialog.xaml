<Window x:Class="OptimizerWpf.Views.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tr="clr-namespace:OptimizerWpf"
        Title="" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MainBgBrush}">
    <!-- 6.9.0 - διάλογος κωδικού πρόσβασης (ένα ή δύο PasswordBox) για το κλείδωμα του διαχειριστή κωδικών browser. -->
    <StackPanel Margin="16">
        <TextBlock x:Name="TxtPrompt" Style="{StaticResource SubTextStyle}" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <PasswordBox x:Name="Pwd1" Margin="0,0,0,8" Padding="6,4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextBrush}" KeyDown="Pwd_KeyDown"/>
        <TextBlock x:Name="TxtPrompt2" Style="{StaticResource SubTextStyle}" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>
        <PasswordBox x:Name="Pwd2" Margin="0,0,0,8" Padding="6,4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextBrush}" Visibility="Collapsed" KeyDown="Pwd_KeyDown"/>
        <TextBlock x:Name="TxtError" Foreground="#FFE53935" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{tr:Tr Cancel}" Style="{StaticResource FlatButtonStyle}" MinWidth="100" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="OK" Style="{StaticResource AccentButtonStyle}" MinWidth="100" Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
