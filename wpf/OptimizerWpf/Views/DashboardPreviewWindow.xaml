<ui:FluentWindow x:Class="OptimizerWpf.Views.DashboardPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:OptimizerWpf.Views"
        mc:Ignorable="d"
        Title="PC Performance &amp; Maintenance Suite"
        Height="840" Width="1360" MinHeight="620" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{DynamicResource MainBgBrush}">
    <!-- ΝΕΟ (GEARWIN.MD, ρητό αίτημα χρήστη: "κάνε τον πίνακα ελέγχου που είναι το κύριο παράθυρο
         της εφαρμογής & βλέπουμε") - πιλοτικό, αυτόνομο παράθυρο (δεν αντικαθιστά το MainWindow)
         που δοκιμάζει το WPF-UI nuget πάνω στο ΙΔΙΟ "Πίνακα Ελέγχου" σχέδιο που ο χρήστης έδειξε με
         screenshot (παλιό όνομα/v5.1.0 "PC Performance & Maintenance Suite"). Χρησιμοποιεί ΠΡΑΓΜΑΤΙΚΑ
         δεδομένα από τις ήδη υπάρχουσες Services (HealthScoreService/SecurityStatusService/
         UpdatesHubService/TweakService) - καμία πλασματική τιμή (ίδιο ήθος ειλικρίνειας με την
         υπόλοιπη εφαρμογή, βλ. NetworkTrafficService/ImpactTrackingService). Ανοίγει μόνο με το
         όρισμα "dashboard-preview" (βλ. App.xaml.cs) - η κανονική εκκίνηση της εφαρμογής (χωρίς
         όρισμα) παραμένει 100% αναλλοίωτη. Το χρώμα/θέμα (CardBgBrush/AccentBrush/TextBrush κ.λπ.)
         έρχεται από το ΙΔΙΟ ThemeManager με το MainWindow - τα WPF-UI controls (ui:Button/ui:Card/
         ui:InfoBar/ui:TitleBar) παίρνουν το δικό τους Fluent resource set μέσω του ThemesDictionary/
         ControlsDictionary παρακάτω, scoped ΜΟΝΟ σε αυτό το παράθυρο (καμία επίδραση στην υπόλοιπη
         εφαρμογή). -->
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Ίδιο DataTemplate/RailPillStyle με του MainWindow.xaml's "RailItemWide" (πλατιά κάθετη
                 μπάρα, PC Manager/Windows 11 Settings skins) - αποδεδειγμένα σωστό/ήδη σε χρήση αντί
                 για χειροποίητο ControlTemplate που δεν μπορώ να επαληθεύσω οπτικά εδώ. Δύο ξεχωριστά
                 DataTemplates (όχι ένα με δεμένο GroupName) - τα NavItem/SidebarShortcut records δεν
                 έχουν δικό τους GroupName property, και οι δύο ομάδες (Καρτέλες/Συντομεύσεις) πρέπει
                 να επιλέγουν ανεξάρτητα η μία από την άλλη. -->
            <DataTemplate x:Key="NavRowTabsTemplate">
                <RadioButton GroupName="PreviewTabs" Style="{StaticResource RailPillStyle}" Click="NavRow_Click" Tag="{Binding}">
                    <StackPanel Orientation="Horizontal">
                        <views:HeaderGlyphIcon Kind="{Binding IconKind}" Width="18" Height="18" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </DataTemplate>
            <DataTemplate x:Key="NavRowShortcutsTemplate">
                <RadioButton GroupName="PreviewShortcuts" Style="{StaticResource RailPillStyle}" Click="NavRow_Click" Tag="{Binding}">
                    <StackPanel Orientation="Horizontal">
                        <views:HeaderGlyphIcon Kind="{Binding IconKind}" Width="18" Height="18" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </DataTemplate>

            <!-- ΔΙΟΡΘΩΣΗ (χρήστης είδε screenshot: "φτιάξε τα χρώματα τις υφές") - χωρίς ρητό Background/
                 BorderBrush, το ui:Card παίρνει το ΔΙΚΟ ΤΟΥ προεπιλεγμένο (σχεδόν μαύρο/διάφανο) φόντο
                 από το ControlsDictionary παραπάνω αντί για το CardBgBrush του ThemeManager - γι' αυτό
                 οι κάρτες δεν ξεχώριζαν καθόλου από το φόντο του παραθύρου. Ίδιο ακριβώς "ύφος" με το
                 CardStyle του Styles.xaml (Background/BorderBrush/BorderThickness/CornerRadius/Padding). -->
            <Style x:Key="DashCardStyle" TargetType="ui:Card">
                <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="20"/>
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <!-- ΔΙΟΡΘΩΣΗ (χρήστης είδε screenshot: "φτιάξε τα χρώματα τις υφές το κινούμενο φόντο") - έλειπε
         τελείως το ThemedBackgroundControl (το ίδιο animated φόντο με MainWindow/SplashWindow) - μόνο
         ένα επίπεδο MainBgBrush, γι' αυτό έδειχνε επίπεδο/σκέτο μαύρο αντί για το κινούμενο θέμα της
         εφαρμογής. ΙΔΙΟ μοτίβο 2 επιπέδων με το SplashWindow.xaml. -->
    <Grid>
        <Border Background="{DynamicResource MainBgBrush}"/>
        <views:ThemedBackgroundControl x:Name="DashboardBackground"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ui:TitleBar Grid.Row="0" x:Name="PreviewTitleBar" Title="PC Performance &amp; Maintenance Suite"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Πλευρικό μενού ===== -->
                <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,20,16,16">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                            <views:ThreeGearIcon Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" x:Name="SidebarTitleBlock">
                            <TextBlock Text="PC Performance &amp; Maintenance Suite" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="TxtSidebarVersion" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,8">
                            <TextBlock x:Name="TxtTabsGroupLabel" Text="ΚΑΡΤΕΛΕΣ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" Margin="12,8,0,6"/>
                            <ItemsControl x:Name="ListTabs" ItemTemplate="{StaticResource NavRowTabsTemplate}"/>
                            <TextBlock x:Name="TxtShortcutsGroupLabel" Text="ΣΥΝΤΟΜΕΥΣΕΙΣ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" Margin="12,16,0,6"/>
                            <ItemsControl x:Name="ListShortcuts" ItemTemplate="{StaticResource NavRowShortcutsTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <ui:Button Grid.Row="2" x:Name="BtnCollapseSidebar" Content="Σύμπτυξη μενού" Appearance="Transparent"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="8" Click="BtnCollapseSidebar_Click"/>
                </Grid>
            </Border>

            <!-- ===== Περιεχόμενο ===== -->
            <Grid Grid.Column="1" Margin="28,20,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Κεφαλίδα -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Πίνακας Ελέγχου" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Καρτέλες" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/>
                    </StackPanel>
                    <ui:Button Grid.Column="2" x:Name="BtnUpdatesPill" Appearance="Secondary" Margin="0,0,10,0" VerticalAlignment="Center" Click="BtnUpdatesPill_Click">
                        <StackPanel Orientation="Horizontal">
                            <views:HeaderGlyphIcon Kind="Bolt" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtUpdatesPill" Text="Έλεγχος ενημερώσεων" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:TextBox Grid.Column="3" x:Name="TxtSearch" Width="220" PlaceholderText="Γρήγορη εντολή... Ctrl K" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <ui:Button Grid.Column="4" x:Name="BtnThemeToggle" Appearance="Transparent" Width="34" Height="34" Padding="0" VerticalAlignment="Center" Click="BtnThemeToggle_Click">
                        <views:HeaderGlyphIcon x:Name="IconThemeToggle" Kind="Palette" Width="16" Height="16"/>
                    </ui:Button>
                </Grid>

                <!-- Ειδοποίηση ενημερώσεων -->
                <ui:InfoBar Grid.Row="1" x:Name="UpdatesInfoBar" Margin="0,0,0,16" IsClosable="True"
                            Severity="Success" Title="" Message=""/>

                <!-- Βαθμολογία Υγείας + Ενημερώσεις -->
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:Card Grid.Column="0" Style="{StaticResource DashCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="100" Height="100" Margin="0,0,20,0">
                                <Ellipse Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="9" Margin="4"/>
                                <Path x:Name="ScoreArc" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource AccentBrush}"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtScore" Text="--" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="/ 100" FontSize="10" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Βαθμολογία Υγείας" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="ListHealthRows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource SubTextBrush}" FontSize="12"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding DotColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding DotColor}" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <ui:Card Grid.Column="2" Style="{StaticResource DashCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Ενημερώσεις Λογισμικού &amp; Οδηγών" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource MainBgBrush}" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Λογισμικό (winget)" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock x:Name="TxtAppUpdateCount" Text="—" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="TxtAppUpdateNames" Text="" FontSize="11" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource MainBgBrush}" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Οδηγοί Συσκευών" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock x:Name="TxtDriverUpdateCount" Text="—" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="TxtDriverUpdateNames" Text="" FontSize="11" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="BtnReviewUpgrade" Content="Ανασκόπηση &amp; Αναβάθμιση" Appearance="Primary" Margin="0,0,8,0" Click="BtnReviewUpgrade_Click"/>
                                <ui:Button x:Name="BtnIgnoreOnce" Content="Αγνόησε αυτή τη φορά" Appearance="Secondary" Click="BtnIgnoreOnce_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtUpdatesStatus" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ui:Card>
                </Grid>

                <!-- Καρφιτσωμένες συντομεύσεις -->
                <ui:Card Grid.Row="3" Style="{StaticResource DashCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Καρφιτσωμένες Συντομεύσεις" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                        </Grid>
                        <TextBlock x:Name="TxtNoPinned" Text="Δεν έχετε καρφιτσωμένες συντομεύσεις ακόμα - καρφιτσώστε από τις Επιπλέον Ρυθμίσεις." Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <ItemsControl x:Name="ListPinnedShortcuts">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource MainBgBrush}" CornerRadius="8" Margin="0,0,10,10" Padding="14">
                                        <StackPanel>
                                            <views:HeaderGlyphIcon Kind="{Binding IconKind}" Width="20" Height="20" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="{Binding SubLabel}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>
            </Grid>
        </Grid>
    </Grid>
    </Grid>
</ui:FluentWindow>
