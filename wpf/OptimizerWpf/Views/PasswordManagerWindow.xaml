<Window x:Class="OptimizerWpf.Views.PasswordManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:tr="clr-namespace:OptimizerWpf"
        mc:Ignorable="d"
        Title="{tr:Tr PwdMgr_Title}" Height="560" Width="820" MinHeight="420" MinWidth="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MainBgBrush}">
    <!-- REQ-570-06: ενοποιημένος διαχειριστής κωδικών browser - βλ. Services/PasswordVaultService.cs
         (μόνο Chromium-family: Chrome/Edge/Brave/Vivaldi/Opera/Opera GX, ΤΟΠΙΚΑ, μόνο ο ίδιος
         Windows χρήστης, καμία δικτυακή μετάδοση). Ίδια σύμβαση με τα υπόλοιπα δευτερεύοντα
         παράθυρα (ThemeManager.AttachWindow, καμία δικιά του κινούμενη ανιμάτε φόντο). -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#33E53935" BorderBrush="#FFE53935" BorderThickness="1"
                CornerRadius="{DynamicResource AppCornerRadius}" Padding="14,10" Margin="0,0,0,14">
            <TextBlock Text="{tr:Tr PwdMgr_Warning}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
        </Border>

        <TextBlock Grid.Row="1" x:Name="TxtStatus" Style="{StaticResource SubTextStyle}" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <TextBox Grid.Row="2" x:Name="TxtSearch" Height="34" Padding="10,6" VerticalContentAlignment="Center" Margin="0,0,0,12"
                 Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                 TextChanged="TxtSearch_TextChanged" ToolTip="{tr:Tr PwdMgr_SearchHint}"/>

        <Border Grid.Row="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="NestedScroll_PreviewMouseWheel">
                <ItemsControl x:Name="ListCredentials">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource MainBgBrush}" CornerRadius="6" Margin="4" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Origin}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{DynamicResource SubTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Browser, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Username, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding DisplayPassword}" Foreground="{DynamicResource SubTextBrush}" FontFamily="Consolas" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding ToggleLabel}" Style="{StaticResource FlatButtonStyle}"
                                            MinWidth="80" Padding="16,6" Margin="0,0,8,0" Click="BtnToggleReveal_Click" Tag="{Binding}"/>
                                    <Button Grid.Column="2" Content="{tr:Tr PwdMgr_CopyBtn}" Style="{StaticResource AccentButtonStyle}"
                                            MinWidth="80" Padding="16,6" Click="BtnCopyPassword_Click" Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="4" Content="{tr:Tr Close}" Style="{StaticResource AccentButtonStyle}" MinWidth="120" HorizontalAlignment="Right" Margin="0,14,0,0" Click="BtnClose_Click"/>
    </Grid>
</Window>
