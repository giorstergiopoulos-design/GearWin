<Window x:Class="OptimizerWpf.Views.WifiPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:tr="clr-namespace:OptimizerWpf"
        mc:Ignorable="d"
        Title="{tr:Tr WifiPwd_Title}" Height="480" Width="640" MinHeight="360" MinWidth="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MainBgBrush}">
    <!-- Πρόταση χρήστη: αποθηκευμένοι κωδικοί Wi-Fi ΑΥΤΟΥ του υπολογιστή - βλ.
         Services/WifiPasswordService.cs (native WLAN API, τοπικά, καμία δικτυακή μετάδοση). -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#33E53935" BorderBrush="#FFE53935" BorderThickness="1"
                CornerRadius="{DynamicResource AppCornerRadius}" Padding="14,10" Margin="0,0,0,14">
            <TextBlock Text="{tr:Tr WifiPwd_Warning}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
        </Border>

        <TextBlock Grid.Row="1" x:Name="TxtStatus" Style="{StaticResource SubTextStyle}" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="NestedScroll_PreviewMouseWheel">
                <ItemsControl x:Name="ListWifiProfiles">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource MainBgBrush}" CornerRadius="6" Margin="4" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DisplayPassword}" Foreground="{DynamicResource SubTextBrush}" FontFamily="Consolas" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding ToggleLabel}" Style="{StaticResource FlatButtonStyle}"
                                            MinWidth="80" Padding="16,6" Margin="0,0,8,0" Click="BtnToggleReveal_Click" Tag="{Binding}"
                                            Visibility="{Binding HasPasswordVisibility}"/>
                                    <Button Grid.Column="2" Content="{tr:Tr PwdMgr_CopyBtn}" Style="{StaticResource AccentButtonStyle}"
                                            MinWidth="80" Padding="16,6" Click="BtnCopyPassword_Click" Tag="{Binding}"
                                            Visibility="{Binding HasPasswordVisibility}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="3" Content="{tr:Tr Close}" Style="{StaticResource AccentButtonStyle}" MinWidth="120" HorizontalAlignment="Right" Margin="0,14,0,0" Click="BtnClose_Click"/>
    </Grid>
</Window>
