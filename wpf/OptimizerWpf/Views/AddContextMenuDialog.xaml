<Window x:Class="OptimizerWpf.Views.AddContextMenuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tr="clr-namespace:OptimizerWpf"
        Title="{tr:Tr Ctx_Title}" Height="300" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MainBgBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="{tr:Tr Ctx_MenuText}" Style="{StaticResource SubTextStyle}" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtMenuText" Margin="0,0,0,12" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextBrush}"/>
        <TextBlock Text="{tr:Tr Ctx_Command}" Style="{StaticResource SubTextStyle}" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtCommand" Margin="0,0,0,12" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextBrush}"/>
        <TextBlock Text="{tr:Tr Ctx_Scope}" Style="{StaticResource SubTextStyle}" Margin="0,0,0,4"/>
        <ComboBox x:Name="CmbScope" Margin="0,0,0,16">
            <ComboBoxItem Content="Files" Tag="Files"/>
            <ComboBoxItem Content="Directory" Tag="Directory" IsSelected="True"/>
            <ComboBoxItem Content="FolderBackground" Tag="FolderBackground"/>
        </ComboBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{tr:Tr Cancel}" Style="{StaticResource FlatButtonStyle}" Width="100" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="{tr:Tr Ctx_AddBtn}" Style="{StaticResource AccentButtonStyle}" Width="100" Click="BtnAdd_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
