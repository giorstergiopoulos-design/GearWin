<Window x:Class="OptimizerWpf.Views.UpdateAnnounceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tr="clr-namespace:OptimizerWpf"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowActivated="False" KeyDown="Window_KeyDown"
        AutomationProperties.Name="GearWin update">
    <!-- 6.7.1 - ίδια κουμπιά/μηνύματα με το popup ενημέρωσης του Crawler: Λήψη/Εγκατάσταση, Αργότερα, Παράλειψη έκδοσης, Τι νέο υπάρχει. -->
    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10"
            Padding="16" Margin="8" MaxWidth="380">
        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35"/></Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TxtTitle" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtBody" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/>
            <WrapPanel>
                <Button x:Name="BtnInstall" Content="{tr:Tr Update_Install}" Style="{StaticResource AccentButtonStyle}" Padding="14,6" Margin="0,0,6,6" Click="BtnInstall_Click"/>
                <Button Content="{tr:Tr Update_Later}" Style="{StaticResource FlatButtonStyle}" Padding="12,6" Margin="0,0,6,6" Click="BtnLater_Click"/>
                <Button Content="{tr:Tr Update_Skip}" Style="{StaticResource FlatButtonStyle}" Padding="12,6" Margin="0,0,6,6" Click="BtnSkip_Click"/>
                <Button Content="{tr:Tr Update_WhatsNew}" Style="{StaticResource FlatButtonStyle}" Padding="12,6" Margin="0,0,6,6" Click="BtnWhatsNew_Click"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
