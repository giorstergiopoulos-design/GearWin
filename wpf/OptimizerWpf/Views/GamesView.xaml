<UserControl x:Class="OptimizerWpf.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:tr="clr-namespace:OptimizerWpf"
             xmlns:views="clr-namespace:OptimizerWpf.Views"
             mc:Ignorable="d">
    <!-- 6.1.0 - ΝΕΑ καρτέλα Παιχνίδια: βιβλιοθήκη (Steam/Epic/GOG/Ubisoft/Xbox) με εκκίνηση/επαλήθευση/
         απεγκατάσταση και ένδειξη εκκρεμούς ενημέρωσης, ρυθμίσεις ανά παιχνίδι (προτίμηση GPU, fullscreen
         optimizations), καθολικά gaming tweaks και καθαρισμός shader cache. Βλ. GameLibraryService,
         GamingTweaksService. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate x:Key="GameRowTemplate">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource AppCornerRadius}" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Entry.Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource TabSelectBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Entry.Launcher}" FontSize="10" Foreground="{DynamicResource TextBrush}"/>
                            </Border>
                            <Border Background="#33F59E0B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding UpdatePending, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{tr:Tr Games_UpdatePending}" FontSize="10" Foreground="{DynamicResource TextBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Details}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{tr:Tr Games_Launch}" Style="{StaticResource AccentButtonStyle}" Padding="12,5" Margin="0,0,6,0" Tag="{Binding}" Click="BtnLaunchGame_Click"
                                Visibility="{Binding CanLaunch, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="{tr:Tr Games_Folder}" Style="{StaticResource FlatButtonStyle}" Padding="10,5" Margin="0,0,6,0" Tag="{Binding}" Click="BtnGameFolder_Click"/>
                        <Button Content="{tr:Tr Games_Verify}" Style="{StaticResource FlatButtonStyle}" Padding="10,5" Margin="0,0,6,0" Tag="{Binding}" Click="BtnVerifyGame_Click"
                                Visibility="{Binding CanVerify, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="{tr:Tr Games_Uninstall}" Style="{StaticResource FlatButtonStyle}" Padding="10,5" Tag="{Binding}" Click="BtnUninstallGame_Click"
                                Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="GameTweakRowTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{Binding Tweak.Label}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Tweak.Description}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="🛡" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.75"
                           Visibility="{Binding AdminBadgeVisibility}" ToolTip="{Binding AdminBadgeTip}"/>
                <ToggleButton Grid.Column="2" IsChecked="{Binding IsOn}" Style="{StaticResource ToggleSwitchStyle}" Click="ToggleGameTweak_Click" Tag="{Binding}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="NestedScroll_PreviewMouseWheel">
        <StackPanel Margin="0,8,0,24">

            <!-- Βιβλιοθήκη -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <views:HeaderGlyphIcon Grid.Column="0" Kind="Gamepad" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{tr:Tr Games_LibraryTitle}" Style="{StaticResource CardTitleStyle}"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="BtnScanGames" Content="{tr:Tr Games_Scan}" Style="{StaticResource AccentButtonStyle}" Padding="16,7" Margin="0,0,10,0" Click="BtnScanGames_Click"/>
                        <ComboBox x:Name="CmbLauncher" Grid.Column="1" Width="140" Margin="0,0,10,0" SelectionChanged="Filter_Changed"/>
                        <TextBox x:Name="TxtGameSearch" Grid.Column="2" Height="32" VerticalContentAlignment="Center" Padding="8,0" TextChanged="Filter_TextChanged"
                                 ToolTip="{tr:Tr Games_SearchHint}"/>
                    </Grid>
                    <TextBlock x:Name="TxtGamesSummary" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="ListGames" ItemTemplate="{StaticResource GameRowTemplate}"/>
                </StackPanel>
            </Border>

            <!-- Ρυθμίσεις ανά παιχνίδι -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <views:HeaderGlyphIcon Grid.Column="0" Kind="Gear" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{tr:Tr Games_PerGameTitle}" Style="{StaticResource CardTitleStyle}"/>
                    </Grid>
                    <TextBlock Text="{tr:Tr Games_PerGameHint}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtGameExe" IsReadOnly="True" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="{tr:Tr Games_ChooseExe}" Style="{StaticResource FlatButtonStyle}" Padding="14,6" Click="BtnChooseExe_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{tr:Tr Games_GpuLabel}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CmbGpuPref" Width="220">
                            <ComboBoxItem Tag="0" Content="{tr:Tr Games_GpuAuto}"/>
                            <ComboBoxItem Tag="1" Content="{tr:Tr Games_GpuPower}"/>
                            <ComboBoxItem Tag="2" Content="{tr:Tr Games_GpuHigh}"/>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="ChkDisableFso" Content="{tr:Tr Games_DisableFso}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                    <Button x:Name="BtnApplyGameSettings" Content="{tr:Tr Games_Apply}" Style="{StaticResource AccentButtonStyle}" Padding="16,7" HorizontalAlignment="Left" IsEnabled="False" Click="BtnApplyGameSettings_Click"/>
                    <TextBlock x:Name="TxtGameSettingsStatus" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Καθολικά gaming tweaks -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <views:HeaderGlyphIcon Grid.Column="0" Kind="Bolt" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{tr:Tr Games_TweaksTitle}" Style="{StaticResource CardTitleStyle}"/>
                    </Grid>
                    <ItemsControl x:Name="ListGameTweaks" ItemTemplate="{StaticResource GameTweakRowTemplate}"/>
                </StackPanel>
            </Border>

            <!-- Shader cache -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <views:HeaderGlyphIcon Grid.Column="0" Kind="Broom" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{tr:Tr Games_ShaderTitle}" Style="{StaticResource CardTitleStyle}"/>
                    </Grid>
                    <TextBlock Text="{tr:Tr Games_ShaderDesc}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button x:Name="BtnCleanShader" Content="{tr:Tr Games_ShaderClean}" Style="{StaticResource FlatButtonStyle}" Padding="16,7" HorizontalAlignment="Left" Click="BtnCleanShader_Click"/>
                    <TextBlock x:Name="TxtShaderStatus" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{tr:Tr Games_UpdatesNote}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="4,12,4,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
