<UserControl x:Class="OptimizerWpf.Views.PowerToolsCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:tr="clr-namespace:OptimizerWpf"
             xmlns:views="clr-namespace:OptimizerWpf.Views"
             mc:Ignorable="d">
    <!-- Εκκίνηση, Υπηρεσίες, Διπλότυπα, Folder Lock, Benchmark - μετακινήθηκαν από την καρτέλα Σύστημα στα Προηγμένα (6.1.0). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <StackPanel>
            <!-- Εκκίνηση -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <views:HeaderGlyphIcon Grid.Column="0" Kind="Bolt" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{tr:Tr System_Startup}" Style="{StaticResource CardTitleStyle}"/>
                        </Grid>
                        <Button Grid.Column="1" Content="{tr:Tr Refresh}" Style="{StaticResource FlatButtonStyle}" Width="120" Click="BtnRefreshStartup_Click"/>
                    </Grid>
                    <ItemsControl x:Name="ListStartup">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Item.Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                            <!-- ΝΕΟ - roadmap "Εκτίμηση χρόνου εκκίνησης" - βλ. SystemService.GetStartupDelayEstimates. -->
                                            <TextBlock Text="{Binding DelayText}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding HasDelay, Converter={StaticResource BoolToVis}}"/>
                                            <!-- ΝΕΟ - roadmap "Startup impact, όχι μόνο πλήθος" - βλ. SystemView.xaml.cs's LoadStartupAsync. -->
                                            <TextBlock Text="{Binding ImpactLabel}" Foreground="{Binding ImpactColor}" FontSize="10" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding HasDelay, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Item.Command}" Style="{StaticResource SubTextStyle}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" IsChecked="{Binding IsEnabled}" Style="{StaticResource ToggleSwitchStyle}" Click="ToggleStartupItem_Click" Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Υπηρεσίες -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <views:HeaderGlyphIcon Grid.Column="0" Kind="Gear" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{tr:Tr System_Services}" Style="{StaticResource CardTitleStyle}"/>
                        </Grid>
                        <Button Grid.Column="1" Content="{tr:Tr Refresh}" Style="{StaticResource FlatButtonStyle}" Width="120" Click="BtnRefreshServices_Click"/>
                    </Grid>
                    <Border Background="{DynamicResource MainBgBrush}" CornerRadius="6" MaxHeight="320" Padding="4">
                        <ListBox x:Name="ListServices" Style="{StaticResource VirtualizedListStyle}" PreviewMouseWheel="NestedScroll_PreviewMouseWheel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Service.DisplayName}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Service.Description}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" IsChecked="{Binding IsAutomatic}" Style="{StaticResource ToggleSwitchStyle}" Click="ToggleService_Click" Tag="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <views:HeaderGlyphIcon Grid.Column="0" Kind="Document" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{tr:Tr Advanced_DuplicateFinder}" Style="{StaticResource CardTitleStyle}"/>
                    </Grid>
                    <TextBlock Text="{tr:Tr Advanced_DuplicateFinderDesc}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtDuplicateFolder" Grid.Column="0" IsReadOnly="True" Margin="0,0,10,0" VerticalContentAlignment="Center"
                                 Background="{DynamicResource MainBgBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                        <Button Grid.Column="1" Content="{tr:Tr Advanced_ChooseFolder}" Style="{StaticResource FlatButtonStyle}" Width="160" Margin="0,0,10,0" Click="BtnChooseDuplicateFolder_Click"/>
                        <Button Grid.Column="2" x:Name="BtnScanDuplicates" Content="{tr:Tr Advanced_ScanDuplicates}" Style="{StaticResource AccentButtonStyle}" Width="160" IsEnabled="False" Click="BtnScanDuplicates_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtDuplicateStatus" Style="{StaticResource SubTextStyle}" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource MainBgBrush}" CornerRadius="6" MinHeight="60" MaxHeight="320" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="NestedScroll_PreviewMouseWheel">
                            <ItemsControl x:Name="ListDuplicateGroups">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,6">
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                                            <ItemsControl ItemsSource="{Binding Files}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="12,1,0,1">
                                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding Path}" Style="{StaticResource SubTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Button x:Name="BtnDeleteDuplicates" Content="{tr:Tr Advanced_DeleteSelectedDuplicates}" Style="{StaticResource FlatButtonStyle}" Background="#FFD12424"
                            Width="240" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="False" Click="BtnDeleteDuplicates_Click"/>
                </StackPanel>
            </Border>

            <!-- ΝΕΟ - roadmap "Κλείδωμα φακέλων με κωδικούς" (ρητό αίτημα χρήστη). Βλ. FolderLockService
                 για την πλήρη τεκμηρίωση του μηχανισμού (AES-256-GCM, όχι BitLocker/VHD - λειτουργεί
                 και σε Windows Home). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <views:HeaderGlyphIcon Grid.Column="0" Kind="Lock" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{tr:Tr FolderLock_Title}" Style="{StaticResource CardTitleStyle}"/>
                    </Grid>
                    <TextBlock Text="{tr:Tr FolderLock_Desc}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Text="{tr:Tr FolderLock_LockSection}" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource TextBrush}"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtLockFolderPath" IsReadOnly="True" Height="32" Padding="8,4" VerticalContentAlignment="Center"
                                 Background="{DynamicResource MainBgBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                        <Button Grid.Column="1" Content="{tr:Tr Advanced_ChooseFolder}" Style="{StaticResource FlatButtonStyle}" Margin="8,0,0,0" Click="BtnChooseLockFolder_Click"/>
                    </Grid>
                    <TextBlock Text="{tr:Tr FolderLock_PasswordHint}" Style="{StaticResource SubTextStyle}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PwdLock" Height="32" Padding="8,4" Margin="0,0,0,6"
                                 Background="{DynamicResource MainBgBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                    <TextBlock Text="{tr:Tr FolderLock_ConfirmPasswordHint}" Style="{StaticResource SubTextStyle}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PwdLockConfirm" Height="32" Padding="8,4" Margin="0,0,0,10"
                                 Background="{DynamicResource MainBgBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                    <Button x:Name="BtnLockFolder" Content="{tr:Tr FolderLock_LockButton}" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Left" Padding="20,8" Click="BtnLockFolder_Click"/>

                    <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,18,0,18"/>

                    <TextBlock Text="{tr:Tr FolderLock_UnlockSection}" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource TextBrush}"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtUnlockVaultPath" IsReadOnly="True" Height="32" Padding="8,4" VerticalContentAlignment="Center"
                                 Background="{DynamicResource MainBgBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                        <Button Grid.Column="1" Content="{tr:Tr FolderLock_ChooseVault}" Style="{StaticResource FlatButtonStyle}" Margin="8,0,0,0" Click="BtnChooseVault_Click"/>
                    </Grid>
                    <TextBlock Text="{tr:Tr FolderLock_PasswordHint}" Style="{StaticResource SubTextStyle}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PwdUnlock" Height="32" Padding="8,4" Margin="0,0,0,10"
                                 Background="{DynamicResource MainBgBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                    <Button x:Name="BtnUnlockFolder" Content="{tr:Tr FolderLock_UnlockButton}" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Left" Padding="20,8" Click="BtnUnlockFolder_Click"/>

                    <TextBlock x:Name="TxtFolderLockStatus" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- Δοκιμή Ταχύτητας Δίσκου -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <views:HeaderGlyphIcon Grid.Column="0" Kind="Disk" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{tr:Tr System_Benchmark}" Style="{StaticResource CardTitleStyle}"/>
                    </Grid>
                    <TextBlock Text="{tr:Tr System_BenchmarkDesc}" Style="{StaticResource SubTextStyle}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox x:Name="CmbBenchmarkDrive" Width="120" Margin="0,0,10,0"/>
                        <Button x:Name="BtnStartBenchmark" Content="{tr:Tr System_StartBenchmark}" Style="{StaticResource AccentButtonStyle}" Width="180" Height="40" Click="BtnStartBenchmark_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,40,0">
                            <TextBlock Text="{tr:Tr System_Write}" Style="{StaticResource SubTextStyle}"/>
                            <TextBlock x:Name="TxtBenchWrite" Text="-- MB/s" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{tr:Tr System_Read}" Style="{StaticResource SubTextStyle}"/>
                            <TextBlock x:Name="TxtBenchRead" Text="-- MB/s" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

    </StackPanel>
</UserControl>
