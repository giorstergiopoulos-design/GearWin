<Window x:Class="OptimizerWpf.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:tr="clr-namespace:OptimizerWpf"
        xmlns:views="clr-namespace:OptimizerWpf.Views"
        mc:Ignorable="d"
        Title="GearWin - Complete PC Care" Height="600" Width="780"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        Background="{DynamicResource MainBgBrush}" KeyDown="Window_KeyDown">
    <!-- ΝΕΟ - "πρώτη κουρτίνα" οδηγού χρήσης (ρητό αίτημα χρήστη: "κουρτίνα με tutorial στο πρώτο
         άνοιγμα της εφαρμογής, με βελάκια για αλλαγή σελίδας και κουμπί επιβεβαίωσης στην τελευταία
         σελίδα") - εμφανίζεται ΠΡΙΝ δημιουργηθεί το MainWindow/SplashWindow (βλ. App.xaml.cs), μόνο
         όσο AppSettings.HasSeenOnboarding == false. Κάθε "διαφάνεια" αντιστοιχεί ακριβώς σε μία από
         τις 8 πραγματικές καρτέλες της εφαρμογής (ίδια εικονίδια/ονόματα με το NavItems.All) ώστε ο
         οδηγός να είναι 1:1 αντιστοιχισμένος με αυτό που θα δει ο χρήστης, όχι γενικό marketing
         κείμενο. Χωρίς δικό του κινούμενο φόντο (ίδια σύμβαση με όλα τα δευτερεύοντα παράθυρα). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button x:Name="BtnSkip" Grid.Row="0" Content="{tr:Tr Onb_Skip}" Style="{StaticResource FlatButtonStyle}"
                Padding="12,6" HorizontalAlignment="Right" Margin="16,14,16,0" Click="BtnSkip_Click"/>

        <Border Grid.Row="1" Margin="50,10,50,10" Padding="20" Background="{DynamicResource CardBgBrush}" CornerRadius="{DynamicResource AppCornerRadius}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
                <!-- ΔΙΟΡΘΩΣΗ (roadmap: "custom εικονίδια στον οδηγό" / "emoji εμφανίζονται ως
                     περιγράμματα") - 2 προσπάθειες μέσω γραμματοσειράς (FontFamily="Segoe UI Emoji",
                     variation selector U+FE0F) επιβεβαιώθηκαν ζωντανά ΑΝΕΠΑΡΚΕΙΣ (⚙ παρέμενε
                     μονόχρωμο) - αντικαταστάθηκε με το ίδιο διανυσματικό HeaderGlyphIcon που
                     χρησιμοποιείται πλέον σε όλους τους τίτλους καρτών της εφαρμογής, εγγυημένα σωστά
                     χρώματα ανεξαρτήτως γραμματοσειράς/Windows build. -->
                <views:HeaderGlyphIcon x:Name="IconSlide" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                <TextBlock x:Name="TxtTitle" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock x:Name="TxtDesc" FontSize="14" Foreground="{DynamicResource SubTextBrush}" LineHeight="21"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

                <!-- ΝΕΟ - roadmap "Βήμα ρύθμισης στον οδηγό" - προαιρετική ερώτηση θέματος/γλώσσας στο
                     τέλος του οδηγού, πριν το "Ξεκινήστε" - ορατό ΜΟΝΟ στην τελευταία διαφάνεια (βλ.
                     UpdateSlide στο code-behind). Ξαναχρησιμοποιεί τα ήδη υπάρχοντα ThemeManager/
                     LanguageService μηχανισμούς - καμία νέα λογική, μόνο συντόμευση στον οδηγό. -->
                <StackPanel x:Name="SetupStepPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed">
                    <Button x:Name="BtnOnbLanguage" Content="Ελληνικά / English / Deutsch / Français" Style="{StaticResource FlatButtonStyle}"
                            Padding="14,8" Margin="0,0,10,0" Click="BtnOnbLanguage_Click"/>
                    <Button x:Name="BtnOnbTheme" Style="{StaticResource FlatButtonStyle}" Padding="14,8" Click="BtnOnbTheme_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel x:Name="DotsPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <Grid Grid.Row="3" Margin="40,0,40,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnBack" Grid.Column="0" Content="◀" Style="{StaticResource FlatButtonStyle}"
                    Width="44" Height="44" FontSize="16" Click="BtnBack_Click" AutomationProperties.Name="{tr:Tr Onb_BackAuto}"/>
            <Button x:Name="BtnNext" Grid.Column="2" Content="▶" Style="{StaticResource FlatButtonStyle}"
                    Width="44" Height="44" FontSize="16" Click="BtnNext_Click" AutomationProperties.Name="{tr:Tr Onb_NextAuto}"/>
            <Button x:Name="BtnConfirm" Grid.Column="2" Content="{tr:Tr Onb_Confirm}" Style="{StaticResource AccentButtonStyle}"
                    MinWidth="140" Padding="18,10" Visibility="Collapsed" Click="BtnConfirm_Click"/>
        </Grid>
    </Grid>
</Window>
