<Window x:Class="OptimizerWpf.Views.DiskDrilldownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Περαιτέρω Ανάλυση" Height="560" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MainBgBrush}">
    <!--
        Port του Show-DiskCategoryDrilldown (Optimizer.ps1 ~18354-18481) - δευτερεύον παράθυρο (ρητό
        αίτημα χρήστη) που ανοίγει από ένα segment/legend item της Ανάλυσης Χώρου Δίσκου
        (HomeView.xaml). Σαρώνει ΤΟΥΣ ΙΔΙΟΥΣ root φακέλους της κατηγορίας ένα επίπεδο βαθιά (κάθε
        άμεσος υποφάκελος + το recursive μέγεθός του), ταξινομημένο φθίνουσα, μέχρι 40 αποτελέσματα -
        ίδιο όριο με το ps1.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtStatus" Grid.Row="0" Text="Ανάλυση σε εξέλιξη..." Style="{StaticResource SubTextStyle}" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ListResults">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding SizeGb, StringFormat={}{0:0.00} GB}" Style="{StaticResource SubTextStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2" Content="Κλείσιμο" Style="{StaticResource AccentButtonStyle}" Width="120" HorizontalAlignment="Right" Margin="0,12,0,0" Click="BtnClose_Click"/>
    </Grid>
</Window>
