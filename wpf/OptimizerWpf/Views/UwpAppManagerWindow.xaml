<Window x:Class="OptimizerWpf.Views.UwpAppManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:views="clr-namespace:OptimizerWpf.Views"
        xmlns:tr="clr-namespace:OptimizerWpf"
        mc:Ignorable="d"
        Title="{tr:Tr Uwp_Title}" Height="640" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MainBgBrush}">
    <!-- Port του Show-UwpAppManagerWindow (Optimizer.ps1 ~14877) - μόνο πραγματικά Store apps
         (SignatureKind=Store, όχι frameworks/resource-packages). -->
    <!-- ΔΙΟΡΘΩΣΗ (χρήστης ζήτησε: "βγάλε από τα δευτερεύοντα παράθυρα το κινούμενο φόντο") - βλ. ίδιο
         σχόλιο στο HelpWindow.xaml. -->
    <Grid>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="TxtSearch" Height="34" Padding="10,4" VerticalContentAlignment="Center" Margin="0,0,10,0" TextChanged="TxtSearch_TextChanged"
                     Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                     ToolTip="{tr:Tr Bloatware_SearchInstalledTooltip}" AutomationProperties.Name="{tr:Tr Bloatware_SearchInstalledTooltip}"/>
            <Button Grid.Column="1" Content="{tr:Tr Scan}" Style="{StaticResource AccentButtonStyle}" MinWidth="150" Height="34" Click="BtnScan_Click"/>
        </Grid>
        <TextBlock Grid.Row="1" x:Name="TxtStatus" Text="{tr:Tr Uwp_ScanPrompt}" Style="{StaticResource SubTextStyle}" Margin="0,10,0,10"/>
        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="NestedScroll_PreviewMouseWheel">
                <ItemsControl x:Name="ListApps" VirtualizingStackPanel.IsVirtualizing="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource MainBgBrush}" CornerRadius="8" Margin="2,3" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PackageFullName}"/>
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource SubTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{tr:Tr Uwp_Uninstall}" Style="{StaticResource FlatButtonStyle}" Padding="16,6" VerticalAlignment="Center" Click="BtnUninstall_Click" Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Button Grid.Row="3" Content="{tr:Tr Close}" Style="{StaticResource AccentButtonStyle}" MinWidth="120" HorizontalAlignment="Right" Margin="0,12,0,0" Click="BtnClose_Click"/>
    </Grid>
    </Grid>
</Window>
