<Window x:Class="OptimizerWpf.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:views="clr-namespace:OptimizerWpf.Views"
        mc:Ignorable="d"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize">
    <!-- Ρητό αίτημα χρήστη: οθόνη εκκίνησης που καλύπτει όλο το παράθυρο με το κινούμενο γρανάζι +
         τίτλο + έκδοση, μετά ο τίτλος/έκδοση εξαφανίζονται με εφέ και το γρανάζι μετακινείται/
         σμικρύνεται ακριβώς στη θέση του πραγματικού γραναζιού πάνω αριστερά στο κύριο παράθυρο (βλ.
         MainWindow's TitleGearBorder) - δημιουργεί την εντύπωση ότι είναι το ΙΔΙΟ αντικείμενο. Το
         SplashWindow μοιράζεται ΑΚΡΙΒΩΣ τα ίδια Left/Top/Width/Height με το MainWindow (ορίζονται στο
         code-behind) ώστε οι τοπικές συντεταγμένες να αντιστοιχούν 1-προς-1 στην οθόνη. -->
    <Grid>
        <Border Background="{DynamicResource MainBgBrush}"/>
        <views:ThemedBackgroundControl x:Name="SplashBackground"/>

        <StackPanel x:Name="TitleBlock" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,170,0,0">
            <TextBlock Text="GearWin" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Text="Complete PC Care" FontSize="12"
                       Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock x:Name="TxtSplashVersion" FontSize="13" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <Canvas IsHitTestVisible="False">
            <Border x:Name="SplashGearBorder" Width="200" Height="200" CornerRadius="45" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="GearScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <views:ThreeGearIcon Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Canvas>
    </Grid>
</Window>
