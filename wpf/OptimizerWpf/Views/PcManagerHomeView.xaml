<UserControl x:Class="OptimizerWpf.Views.PcManagerHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:tr="clr-namespace:OptimizerWpf"
             xmlns:views="clr-namespace:OptimizerWpf.Views"
             mc:Ignorable="d">
    <!-- 6.1.0 - Αρχική του skin "Microsoft PC Manager" στη λογική του αυθεντικού: κεντρικό "hero" με
         δακτύλιο βαθμολογίας υγείας, κουμπιά Ενίσχυση (Boost) και Έλεγχος υγείας, και κάρτες γρήγορης
         πρόσβασης (Αποθήκευση, Διεργασίες, Εκκίνηση, Ενημερώσεις). Η κανονική Αρχική (HomeView) μένει
         για όλα τα άλλα skins/θέματα. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="NestedScroll_PreviewMouseWheel">
        <StackPanel Margin="0,8,0,24">
            <Border Style="{StaticResource CardStyle}" Padding="28">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                    <Grid Width="200" Height="200" Margin="0,0,32,0" VerticalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="14" Margin="7"/>
                        <Path x:Name="ScoreArc" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource AccentBrush}"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtScore" Text="--" FontSize="52" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="{tr:Tr PcmHome_ScoreCaption}" Style="{StaticResource SubTextStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeadline" Text="{tr:Tr PcmHome_Scanning}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtDetail" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,6,0,20"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnBoost" Content="{tr:Tr PcmHome_Boost}" Style="{StaticResource AccentButtonStyle}" MinWidth="170" Padding="24,12" FontSize="15" Margin="0,0,12,0" Click="BtnBoost_Click"/>
                            <Button x:Name="BtnHealthCheck" Content="{tr:Tr HealthCheck_Title}" Style="{StaticResource FlatButtonStyle}" MinWidth="170" Padding="24,12" FontSize="15" Click="BtnHealthCheck_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtBoostResult" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Columns="4" Margin="0,16,0,0">
                <Button Style="{StaticResource FlatButtonStyle}" Padding="16" Margin="0,0,8,0" Tag="System" Click="QuickCard_Click" HorizontalContentAlignment="Left">
                    <StackPanel>
                        <views:HeaderGlyphIcon Kind="Disk" Width="26" Height="26" HorizontalAlignment="Left"/>
                        <TextBlock Text="{tr:Tr System_Storage}" FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{tr:Tr PcmHome_StorageDesc}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButtonStyle}" Padding="16" Margin="8,0,8,0" Tag="System" Click="QuickCard_Click" HorizontalContentAlignment="Left">
                    <StackPanel>
                        <views:HeaderGlyphIcon Kind="Dial" Width="26" Height="26" HorizontalAlignment="Left"/>
                        <TextBlock Text="{tr:Tr System_Processes}" FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{tr:Tr PcmHome_ProcessesDesc}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButtonStyle}" Padding="16" Margin="8,0,8,0" Tag="Advanced" Click="QuickCard_Click" HorizontalContentAlignment="Left">
                    <StackPanel>
                        <views:HeaderGlyphIcon Kind="Bolt" Width="26" Height="26" HorizontalAlignment="Left"/>
                        <TextBlock Text="{tr:Tr System_Startup}" FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{tr:Tr PcmHome_StartupDesc}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButtonStyle}" Padding="16" Margin="8,0,0,0" Tag="Optimization" Click="QuickCard_Click" HorizontalContentAlignment="Left">
                    <StackPanel>
                        <views:HeaderGlyphIcon Kind="Package" Width="26" Height="26" HorizontalAlignment="Left"/>
                        <TextBlock Text="{tr:Tr PcmHome_UpdatesTitle}" FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{tr:Tr PcmHome_UpdatesDesc}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
