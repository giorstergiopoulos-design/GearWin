<UserControl x:Class="OptimizerWpf.Views.SidebarNav"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:OptimizerWpf.Views"
             mc:Ignorable="d">
    <!--
        Port ΤΟΥ ΠΡΑΓΜΑΤΙΚΟΥ μοντέρνου πλευρικού μενού του Optimizer.ps1 (Add-SidebarItem, βλ.
        SidebarShortcuts.cs) - ΕΠΙΠΕΔΗ λίστα 6 τετραγωνισμένων pills (μεγάλο εικονίδιο + πλήρης
        ετικέτα 2 γραμμών από κάτω), ΧΩΡΙΣ ομάδες/submenus, ΧΩΡΙΣ τις καρτέλες (αυτές έχουν ήδη τη
        δική τους οριζόντια λωρίδα - ρητή διόρθωση χρήστη: "δεν θέλω τα submenus"/"άφησες τις
        καρτέλες μέσα"). Καθαρά presentation + 1 event (ShortcutClicked) - το MainWindow αποφασίζει
        τι σημαίνει κάθε κλικ (προς το παρόν πάντα "δεν έχει μεταφερθεί ακόμα", αφού κανένα από τα 6
        δευτερεύοντα παράθυρα δεν έχει χτιστεί ακόμα στο WPF).
    -->
    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="NestedScroll_PreviewMouseWheel">
            <ItemsControl x:Name="ListItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Λίγο πιο συμπαγές μέγεθος (84x84 από 92x96, ρητό αίτημα χρήστη: "να χωράει
                             ακριβώς χωρίς scrollbar") - πιο κοντά στο 86x90 του ps1 original ούτως ή άλλως. -->
                        <Button Click="Shortcut_Click" Tag="{Binding}" Style="{StaticResource FlatButtonStyle}"
                                Width="88" Height="84" Margin="0,0,0,4" Padding="0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <views:HeaderGlyphIcon Kind="{Binding IconKind}" Width="24" Height="24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" TextAlignment="Center"
                                           FontSize="10.5" Foreground="{DynamicResource TextBrush}" Width="80"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
