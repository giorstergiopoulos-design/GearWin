<UserControl x:Class="OptimizerWpf.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!--
        Stage 1 vertical slice: the Home tab, matching Optimizer.ps1's $tabHome (Add-CustomTabPage
        "TabHome") layout - CPU/RAM/Disk metric cards, Health Score card, Disk Analysis card.
        CPU/RAM values below are wired to live data (see HomeView.xaml.cs); Disk %/free-space,
        Health Score, and Disk Analysis are still static placeholders - the next increment is
        porting Get-SystemHealthScore's logic and the disk-usage WMI queries.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,24">

            <TextBlock Text="Παρακολούθηση Απόδοσης Συστήματος" Style="{StaticResource CardTitleStyle}" FontSize="16" Margin="0,0,0,12"/>

            <!-- ΔΙΟΡΘΩΣΗ (ρητό αίτημα χρήστη: 4ο πλακίδιο GPU) - 4 ίσες στήλες αντί για 3, τα
                 υπάρχοντα 3 στένεψαν αναλογικά για να χωρέσει το νέο. Θερμοκρασία (🌡, ρητό αίτημα
                 χρήστη) σε CPU/Disk/GPU - ΟΧΙ στο RAM (καμία τυπική/καθολικά προσβάσιμη πηγή
                 θερμοκρασίας RAM υπάρχει, βλ. HANDOFF.md). Όταν μια θερμοκρασία δεν είναι διαθέσιμη
                 σε αυτό το hardware, δείχνει τίμια "—", ΠΟΤΕ ψευδή τιμή - βλ. HardwareSensorService/
                 GpuInfoService. -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="24" Margin="0,0,0,8">
                            <Border.Background>
                                <RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                    <GradientStop Color="#FF6EC6FF" Offset="0"/>
                                    <GradientStop Color="#FF2196F3" Offset="0.6"/>
                                    <GradientStop Color="#FF0D47A1" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                            <TextBlock Text="⚙" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="CPU" Style="{StaticResource CardTitleStyle}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtCpuPercent" Text="--%" FontSize="22" FontWeight="Bold" Foreground="#FF2196F3" HorizontalAlignment="Center" Margin="0,4,0,6"/>
                        <ProgressBar x:Name="BarCpu" Height="6" Width="120" Minimum="0" Maximum="100" Foreground="#FF2196F3"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock Text="🌡" FontSize="16" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtCpuTemp" Text="—" Style="{StaticResource TempValueStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="24" Margin="0,0,0,8">
                            <Border.Background>
                                <RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                    <GradientStop Color="#FF8BEA9E" Offset="0"/>
                                    <GradientStop Color="#FF4CAF50" Offset="0.6"/>
                                    <GradientStop Color="#FF1B5E20" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#x1F4BE;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="RAM" Style="{StaticResource CardTitleStyle}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtRamPercent" Text="--%" FontSize="22" FontWeight="Bold" Foreground="#FF4CAF50" HorizontalAlignment="Center" Margin="0,4,0,6"/>
                        <ProgressBar x:Name="BarRam" Height="6" Width="120" Minimum="0" Maximum="100" Foreground="#FF4CAF50"/>
                        <TextBlock x:Name="TxtRamDetail" Text="-- / -- GB" Style="{StaticResource SubTextStyle}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Disk - βελάκια αριστερά/δεξιά στα άκρα του πλακιδίου για εναλλαγή δίσκου· το
                     εικονίδιο/χρώμα αλλάζει ανάλογα με τον τύπο (HDD/SSD/USB) μέσω του
                     UpdateDiskIconAsync στο code-behind, το οποίο τραβάει ΚΑΙ τη μάρκα/περιγραφή
                     (TxtDriveModel, ρητό αίτημα χρήστη) ΚΑΙ τη θερμοκρασία (αν υπάρχει). -->
                <Border Grid.Column="6" Style="{StaticResource CardStyle}">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center">
                            <Border x:Name="BorderDiskIcon" Width="48" Height="48" CornerRadius="24" Margin="0,0,0,8">
                                <TextBlock x:Name="TxtDiskIcon" Text="&#x1F4BF;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtDriveLabel" Text="C:" Style="{StaticResource CardTitleStyle}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtDriveKind" Text="" Style="{StaticResource SubTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtDiskPercent" Text="--%" FontSize="22" FontWeight="Bold" Foreground="#FFFF9800" HorizontalAlignment="Center" Margin="0,4,0,6"/>
                            <ProgressBar x:Name="BarDisk" Height="6" Width="120" Minimum="0" Maximum="100" Foreground="#FFFF9800"/>
                            <TextBlock x:Name="TxtDiskDetail" Text="-- GB ελεύθερα από -- GB" Style="{StaticResource SubTextStyle}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock x:Name="TxtDriveModel" Text="" Style="{StaticResource SubTextStyle}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontSize="10"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock Text="🌡" FontSize="16" Margin="0,0,5,0"/>
                                <TextBlock x:Name="TxtDiskTemp" Text="—" Style="{StaticResource TempValueStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="BtnDrivePrev" Content="&#x2039;" FontSize="18" FontWeight="Bold" Width="24" Height="36"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,20,0,0" Style="{StaticResource FlatButtonStyle}" Click="BtnDrivePrev_Click"/>
                        <Button x:Name="BtnDriveNext" Content="&#x203A;" FontSize="18" FontWeight="Bold" Width="24" Height="36"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,0,0" Style="{StaticResource FlatButtonStyle}" Click="BtnDriveNext_Click"/>
                    </Grid>
                </Border>

                <!-- GPU (νέο, ρητό αίτημα χρήστη) - όνομα/χρήση μέσω GpuInfoService (ενσωματωμένη
                     κατηγορία μετρητών "GPU Engine", καμία vendor εξάρτηση), θερμοκρασία μέσω
                     SensorService (LibreHardwareMonitorLib - βλ. HANDOFF.md) - δείχνει "—" αν το
                     hardware/driver δεν την εκθέτει, ΠΟΤΕ ψευδή τιμή. Σειρά πλακιδίων CPU/GPU/RAM/
                     Disk (ρητό αίτημα χρήστη) - Grid.Column="2", όχι πλέον τελευταίο. -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="24" Margin="0,0,0,8">
                            <Border.Background>
                                <RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                    <GradientStop Color="#FFD9A8FF" Offset="0"/>
                                    <GradientStop Color="#FF9C27B0" Offset="0.6"/>
                                    <GradientStop Color="#FF4A0072" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#x1F5A5;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="GPU" Style="{StaticResource CardTitleStyle}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtGpuPercent" Text="--%" FontSize="22" FontWeight="Bold" Foreground="#FF9C27B0" HorizontalAlignment="Center" Margin="0,4,0,6"/>
                        <ProgressBar x:Name="BarGpu" Height="6" Width="120" Minimum="0" Maximum="100" Foreground="#FF9C27B0"/>
                        <TextBlock x:Name="TxtGpuName" Text="" Style="{StaticResource SubTextStyle}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontSize="10" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="🌡" FontSize="16" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtGpuTemp" Text="—" Style="{StaticResource TempValueStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Health Score -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Βαθμολογία Υγείας Συστήματος" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtHealthScore" Text="--" FontSize="38" FontWeight="Bold" Foreground="#FF4CAF50" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtHealthLabel" Text="Έλεγχος..." FontStyle="Italic" Foreground="#FF4CAF50" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource MainBgBrush}" CornerRadius="6" MinHeight="90" MaxHeight="140" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ListHealthIssues">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Ellipse Width="8" Height="8" Fill="{Binding DotColor}" Margin="0,4,8,0" VerticalAlignment="Top"/>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SubTextStyle}" Foreground="{DynamicResource TextBrush}" Width="720"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Διόρθωση Όλων" Style="{StaticResource AccentButtonStyle}" Width="150" Margin="0,0,10,0" Click="BtnFixAllHealth_Click"/>
                        <Button Content="Ανανέωση" Style="{StaticResource FlatButtonStyle}" Width="150" Click="BtnRefreshHealth_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Disk Analysis -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ανάλυση Χώρου Δίσκου ανά Κατηγορία" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtDiskAnalysisStatus" Text="Πατήστε 'Ανάλυση' για κατανομή χώρου ανά κατηγορία (επιλεγμένος δίσκος από την κάρτα Δίσκου παραπάνω)." Style="{StaticResource SubTextStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Ανάλυση" Style="{StaticResource AccentButtonStyle}" Width="130" VerticalAlignment="Center" Click="BtnAnalyzeDisk_Click"/>
                    </Grid>

                    <!-- Port του ps1's $global:diskAnalysisBarWrap/$diskAnalysisLegendPanel (ρητό αίτημα
                         χρήστη: "σε μια μπάρα όπως στο ps1 με επιμέρους περιγραφή σε δύο γραμμές από
                         κάτω") - ΜΙΑ οριζόντια μπάρα χωρισμένη σε έγχρωμα segments (πλάτος ανάλογο του
                         μεγέθους κάθε κατηγορίας, βλ. BtnAnalyzeDisk_Click που χτίζει τις στήλες του
                         DiskBarGrid), ΟΧΙ πλέον ξεχωριστή μπάρα ανά κατηγορία. Το legend από κάτω
                         επιτρέπει αναδίπλωση σε 2 γραμμές (WrapPanel) - κλικ σε segment/legend item
                         ανοίγει το δευτερεύον παράθυρο DiskDrilldownWindow αν η κατηγορία έχει roots. -->
                    <Border Height="16" CornerRadius="8" Background="{DynamicResource BtnDefaultBrush}" Margin="0,12,0,10" ClipToBounds="True">
                        <Grid x:Name="DiskBarGrid"/>
                    </Border>
                    <ItemsControl x:Name="ListDiskLegend">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="DiskLegendItem_Click" Tag="{Binding}" Style="{StaticResource FlatButtonStyle}"
                                        Background="Transparent" Padding="4,3" Margin="0,0,10,6" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" MaxWidth="220">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="{Binding BarColor}" VerticalAlignment="Top" Margin="0,3,6,0"/>
                                        <TextBlock Text="{Binding LegendText}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
