<UserControl x:Class="OptimizerWpf.Views.HeaderGlyphIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="18" d:DesignHeight="18" x:Name="Root">
    <!-- ΝΕΟ - ρητό αίτημα χρήστη: "όπως στο roadmap, χρησιμοποίησε ίδιας ποιότητας και λογικής
         εικονίδια... σε όλα τα επίπεδα της εφαρμογής που υπάρχουν εικονίδια" - επέκταση του ήδη
         αποδεδειγμένου μοτίβου (ThermometerIcon κ.λπ.): τα emoji δεν αποδίδονται σωστά χρωματικά στο
         WPF TextBlock, οπότε όλοι οι τίτλοι καρτών που ξεκινούσαν με emoji (🖥💾🛡🔒🎮🧠📦📱🔧🛠🧹🎛📶🔋)
         αντικαθίστανται με ένα ΕΝΙΑΙΟ, επαναχρησιμοποιήσιμο vector-icon control (14 είδη μέσω Kind),
         σχεδιασμένα ως μονόχρωμα outline εικονίδια με {DynamicResource AccentBrush} ώστε να
         ακολουθούν αυτόματα ΚΑΘΕ θέμα/mode (light/dark/έγχρωμο accent) - συνεπές σε όλη την εφαρμογή. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="20" Height="20">

            <Canvas x:Name="PartMonitor" Width="20" Height="20" Visibility="Collapsed">
                <Rectangle Canvas.Left="2" Canvas.Top="3" Width="16" Height="10" RadiusX="1.5" RadiusY="1.5"
                           Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                <Rectangle Canvas.Left="8" Canvas.Top="13" Width="4" Height="2" Fill="{DynamicResource AccentBrush}"/>
                <Rectangle Canvas.Left="6" Canvas.Top="15.2" Width="8" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>

            <Canvas x:Name="PartDisk" Width="20" Height="20" Visibility="Collapsed">
                <Rectangle Canvas.Left="2" Canvas.Top="4" Width="16" Height="12" RadiusX="6" RadiusY="6"
                           Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                <Line X1="2" Y1="10" X2="18" Y2="10" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"/>
                <Ellipse Canvas.Left="13.5" Canvas.Top="6.5" Width="2.4" Height="2.4" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>

            <Canvas x:Name="PartSignalBars" Width="20" Height="20" Visibility="Collapsed">
                <Rectangle Canvas.Left="3" Canvas.Top="12" Width="3" Height="4" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}"/>
                <Rectangle Canvas.Left="8.5" Canvas.Top="8" Width="3" Height="8" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}"/>
                <Rectangle Canvas.Left="14" Canvas.Top="4" Width="3" Height="12" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>

            <Canvas x:Name="PartBattery" Width="20" Height="20" Visibility="Collapsed">
                <Rectangle Canvas.Left="2" Canvas.Top="6" Width="15" Height="8" RadiusX="2" RadiusY="2"
                           Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                <Rectangle Canvas.Left="17.3" Canvas.Top="9" Width="1.8" Height="2" RadiusX="0.6" RadiusY="0.6" Fill="{DynamicResource AccentBrush}"/>
                <Rectangle Canvas.Left="4" Canvas.Top="8" Width="8" Height="4" Fill="{DynamicResource AccentBrush}" Opacity="0.85"/>
            </Canvas>

            <!-- ΔΙΟΡΘΩΣΗ (χρήστης ανέφερε ζωντανά, με screenshot: το "Tools" εικονίδιο διαβάζεται σαν
                 απλό "X" στην καρτέλα "Προηγμένα Εργαλεία") - οι σταυρωτές μπάρες (ακόμα και με
                 προσθήκη μικρών απολήξεων) παρέμεναν οπτικά αδιάκριτες από ένα απλό X στο μέγεθος
                 20px, ζωντανά επιβεβαιωμένο 2 φορές - αντικαταστάθηκε εντελώς με ένα ξεκάθαρο σχήμα
                 "εργαλειοθήκης" (κουτί + λαβή), αναγνωρίσιμο χωρίς αμφισβήτηση. -->
            <Canvas x:Name="PartTools" Width="20" Height="20" Visibility="Collapsed">
                <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Fill="Transparent">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="7,7" IsClosed="False">
                                <ArcSegment Point="13,7" Size="3,4" SweepDirection="Clockwise" IsLargeArc="False"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
                <Rectangle Canvas.Left="2" Canvas.Top="7" Width="16" Height="10" RadiusX="1.5" RadiusY="1.5"
                           Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Fill="{DynamicResource CardBgBrush}"/>
                <Line X1="2" Y1="11.2" X2="18" Y2="11.2" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"/>
                <Rectangle Canvas.Left="8.6" Canvas.Top="10" Width="2.8" Height="2.4" RadiusX="0.5" RadiusY="0.5" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>

            <Canvas x:Name="PartWrench" Width="20" Height="20" Visibility="Collapsed">
                <Rectangle Canvas.Left="6" Canvas.Top="9" Width="12" Height="2.6" RadiusX="1.3" RadiusY="1.3"
                           Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><RotateTransform Angle="-40"/></Rectangle.RenderTransform>
                </Rectangle>
                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="7" Height="7"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Fill="Transparent"/>
                <Rectangle Canvas.Left="14" Canvas.Top="14.5" Width="4" Height="4" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>

            <!-- ΔΙΟΡΘΩΣΗ (χρήστης ανέφερε ζωντανά, με screenshot, 2 φορές: το εικονίδιο "σκούπας"
                 διαβάζεται σαν "check mark") - μια διαγώνια λαβή + πλαϊνή ανεμιστηρωτή βάση μοιάζει
                 οπτικά με "✓" σε μικρό μέγεθος ανεξαρτήτως ακριβούς γωνίας - αντικαταστάθηκε με ΚΑΘΕΤΗ
                 λαβή (καμία διαγώνια γραμμή που να μπορεί να συγχυστεί με check mark) + συμμετρική
                 βάση φιόγκου ΚΕΝΤΡΑΡΙΣΜΕΝΗ κάτω από τη λαβή. -->
            <Canvas x:Name="PartBroom" Width="20" Height="20" Visibility="Collapsed">
                <Line X1="10" Y1="2" X2="10" Y2="12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Polygon Points="10,11 14,11 17,18 3,18" Fill="{DynamicResource AccentBrush}" Opacity="0.85"/>
                <Line X1="6.5" Y1="12.5" X2="5" Y2="18" Stroke="{DynamicResource AccentBrush}" StrokeThickness="0.8" Opacity="0.6"/>
                <Line X1="10" Y1="12.5" X2="10" Y2="18" Stroke="{DynamicResource AccentBrush}" StrokeThickness="0.8" Opacity="0.6"/>
                <Line X1="13.5" Y1="12.5" X2="15" Y2="18" Stroke="{DynamicResource AccentBrush}" StrokeThickness="0.8" Opacity="0.6"/>
            </Canvas>

            <Canvas x:Name="PartShield" Width="20" Height="20" Visibility="Collapsed">
                <Polygon Points="10,2 17,4.5 17,10.5 10,18 3,10.5 3,4.5" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                          StrokeLineJoin="Round" Fill="Transparent"/>
                <Polyline Points="6.5,9.5 9,12.5 14,6.5" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                           StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
            </Canvas>

            <Canvas x:Name="PartLock" Width="20" Height="20" Visibility="Collapsed">
                <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Fill="Transparent">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="6,9" IsClosed="False">
                                <ArcSegment Point="14,9" Size="4,5" SweepDirection="Clockwise" IsLargeArc="False"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
                <Rectangle Canvas.Left="3.5" Canvas.Top="9" Width="13" Height="9" RadiusX="2" RadiusY="2"
                           Fill="{DynamicResource CardBgBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"/>
                <Ellipse Canvas.Left="9" Canvas.Top="12" Width="2" Height="2" Fill="{DynamicResource AccentBrush}"/>
                <Rectangle Canvas.Left="9.6" Canvas.Top="13.4" Width="0.8" Height="2" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>

            <Canvas x:Name="PartDial" Width="20" Height="20" Visibility="Collapsed">
                <Line X1="5" Y1="3" X2="5" Y2="17" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" Opacity="0.6"/>
                <Line X1="10" Y1="3" X2="10" Y2="17" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" Opacity="0.6"/>
                <Line X1="15" Y1="3" X2="15" Y2="17" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" Opacity="0.6"/>
                <Rectangle Canvas.Left="3.2" Canvas.Top="6" Width="3.6" Height="3" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}"/>
                <Rectangle Canvas.Left="8.2" Canvas.Top="11.5" Width="3.6" Height="3" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}"/>
                <Rectangle Canvas.Left="13.2" Canvas.Top="4.5" Width="3.6" Height="3" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>

            <Canvas x:Name="PartBrain" Width="20" Height="20" Visibility="Collapsed">
                <Line X1="5" Y1="6" X2="10" Y2="12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Opacity="0.55"/>
                <Line X1="15" Y1="6" X2="10" Y2="12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Opacity="0.55"/>
                <Line X1="5" Y1="16" X2="10" Y2="12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Opacity="0.55"/>
                <Line X1="15" Y1="16" X2="10" Y2="12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Opacity="0.55"/>
                <Line X1="5" Y1="6" X2="5" Y2="16" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Opacity="0.4"/>
                <Line X1="15" Y1="6" X2="15" Y2="16" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Opacity="0.4"/>
                <Ellipse Canvas.Left="3.5" Canvas.Top="4.5" Width="3" Height="3" Fill="{DynamicResource AccentBrush}"/>
                <Ellipse Canvas.Left="13.5" Canvas.Top="4.5" Width="3" Height="3" Fill="{DynamicResource AccentBrush}"/>
                <Ellipse Canvas.Left="3.5" Canvas.Top="14.5" Width="3" Height="3" Fill="{DynamicResource AccentBrush}"/>
                <Ellipse Canvas.Left="13.5" Canvas.Top="14.5" Width="3" Height="3" Fill="{DynamicResource AccentBrush}"/>
                <Ellipse Canvas.Left="8.4" Canvas.Top="10.4" Width="3.2" Height="3.2" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>

            <Canvas x:Name="PartGamepad" Width="20" Height="20" Visibility="Collapsed">
                <Rectangle Canvas.Left="2" Canvas.Top="7" Width="16" Height="8" RadiusX="4" RadiusY="4"
                           Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                <Line X1="6.3" Y1="9.3" X2="6.3" Y2="12.7" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"/>
                <Line X1="4.6" Y1="11" X2="8" Y2="11" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"/>
                <Ellipse Canvas.Left="13.2" Canvas.Top="8.3" Width="2.2" Height="2.2" Fill="{DynamicResource AccentBrush}"/>
                <Ellipse Canvas.Left="15.4" Canvas.Top="10.5" Width="2.2" Height="2.2" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>

            <Canvas x:Name="PartPackage" Width="20" Height="20" Visibility="Collapsed">
                <Rectangle Canvas.Left="3" Canvas.Top="7" Width="14" Height="10"
                           Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                <Polyline Points="3,7 10,3.2 17,7" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"
                           StrokeLineJoin="Round" Fill="Transparent"/>
                <Line X1="10" Y1="7" X2="10" Y2="17" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Opacity="0.6"/>
            </Canvas>

            <Canvas x:Name="PartPhone" Width="20" Height="20" Visibility="Collapsed">
                <Rectangle Canvas.Left="6" Canvas.Top="2" Width="8" Height="16" RadiusX="2" RadiusY="2"
                           Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                <Line X1="8.5" Y1="15.6" X2="11.5" Y2="15.6" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse Canvas.Left="9.2" Canvas.Top="3.4" Width="1.6" Height="1.6" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>

            <!-- ΝΕΟ - επέκταση για τον οδηγό χρήσης (roadmap "Οπτικά": "custom εικονίδια στον οδηγό
                 χρήστη" / "emoji εμφανίζονται ως περιγράμματα" - 2 αποτυχημένες προσπάθειες διόρθωσης
                 μέσω γραμματοσειράς, βλ. OnboardingWindow.xaml.cs - μόνο τα πραγματικά διανυσματικά
                 εικονίδια αποδεδειγμένα λειτουργούν σε αυτό το περιβάλλον). -->
            <Canvas x:Name="PartGear" Width="20" Height="20" Visibility="Collapsed">
                <Rectangle Canvas.Left="9" Canvas.Top="0.5" Width="2" Height="4" Fill="{DynamicResource AccentBrush}"/>
                <Rectangle Canvas.Left="9" Canvas.Top="15.5" Width="2" Height="4" Fill="{DynamicResource AccentBrush}"/>
                <Rectangle Canvas.Left="9" Canvas.Top="0.5" Width="2" Height="4" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,9.5">
                    <Rectangle.RenderTransform><RotateTransform Angle="45" CenterX="1" CenterY="9.5"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Canvas.Left="9" Canvas.Top="0.5" Width="2" Height="4" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,9.5">
                    <Rectangle.RenderTransform><RotateTransform Angle="90" CenterX="1" CenterY="9.5"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Canvas.Left="9" Canvas.Top="0.5" Width="2" Height="4" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,9.5">
                    <Rectangle.RenderTransform><RotateTransform Angle="135" CenterX="1" CenterY="9.5"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Canvas.Left="9" Canvas.Top="0.5" Width="2" Height="4" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,9.5">
                    <Rectangle.RenderTransform><RotateTransform Angle="225" CenterX="1" CenterY="9.5"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Canvas.Left="9" Canvas.Top="0.5" Width="2" Height="4" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,9.5">
                    <Rectangle.RenderTransform><RotateTransform Angle="270" CenterX="1" CenterY="9.5"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Canvas.Left="9" Canvas.Top="0.5" Width="2" Height="4" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,9.5">
                    <Rectangle.RenderTransform><RotateTransform Angle="315" CenterX="1" CenterY="9.5"/></Rectangle.RenderTransform>
                </Rectangle>
                <Ellipse Canvas.Left="4" Canvas.Top="4" Width="12" Height="12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Fill="{DynamicResource CardBgBrush}"/>
                <Ellipse Canvas.Left="8" Canvas.Top="8" Width="4" Height="4" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>

            <Canvas x:Name="PartHome" Width="20" Height="20" Visibility="Collapsed">
                <Polygon Points="10,2 18,9 15,9 15,18 5,18 5,9 2,9" Fill="Transparent"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                <Rectangle Canvas.Left="8.5" Canvas.Top="12" Width="3" Height="6" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>

            <Canvas x:Name="PartBolt" Width="20" Height="20" Visibility="Collapsed">
                <Polygon Points="11,1 4,11 9,11 8,19 16,8 11,8" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>

            <Canvas x:Name="PartHeart" Width="20" Height="20" Visibility="Collapsed">
                <Path Fill="{DynamicResource AccentBrush}">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="10,17" IsClosed="True">
                                <BezierSegment Point1="1,10" Point2="1,3" Point3="6,3"/>
                                <BezierSegment Point1="8.5,3" Point2="9.5,4.5" Point3="10,5.5"/>
                                <BezierSegment Point1="10.5,4.5" Point2="11.5,3" Point3="14,3"/>
                                <BezierSegment Point1="19,3" Point2="19,10" Point3="10,17"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Canvas>

            <Canvas x:Name="PartGlobe" Width="20" Height="20" Visibility="Collapsed">
                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="16" Height="16" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                <Ellipse Canvas.Left="6.5" Canvas.Top="2" Width="7" Height="16" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Fill="Transparent"/>
                <Line X1="2" Y1="10" X2="18" Y2="10" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3"/>
            </Canvas>

            <Canvas x:Name="PartCheck" Width="20" Height="20" Visibility="Collapsed">
                <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="17" Height="17" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Fill="Transparent"/>
                <Polyline Points="5.5,10.3 8.7,13.5 14.5,6.8" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                           StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
            </Canvas>

            <Canvas x:Name="PartPalette" Width="20" Height="20" Visibility="Collapsed">
                <Path Fill="Transparent" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeLineJoin="Round">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="18,10" IsClosed="True">
                                <ArcSegment Point="10,2" Size="8,8" SweepDirection="Counterclockwise" IsLargeArc="False"/>
                                <ArcSegment Point="2,10" Size="8,8" SweepDirection="Counterclockwise" IsLargeArc="False"/>
                                <ArcSegment Point="8,17" Size="4,4" SweepDirection="Clockwise" IsLargeArc="True"/>
                                <ArcSegment Point="12.5,15.3" Size="2,2" SweepDirection="Clockwise" IsLargeArc="False"/>
                                <ArcSegment Point="18,10" Size="4,4" SweepDirection="Clockwise" IsLargeArc="False"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
                <Ellipse Canvas.Left="9" Canvas.Top="13" Width="3" Height="3" Fill="{DynamicResource AccentBrush}"/>
                <Ellipse Canvas.Left="4.5" Canvas.Top="7" Width="2.6" Height="2.6" Fill="{DynamicResource AccentBrush}" Opacity="0.85"/>
                <Ellipse Canvas.Left="8.5" Canvas.Top="4" Width="2.6" Height="2.6" Fill="{DynamicResource AccentBrush}" Opacity="0.7"/>
                <Ellipse Canvas.Left="13" Canvas.Top="6.5" Width="2.6" Height="2.6" Fill="{DynamicResource AccentBrush}" Opacity="0.55"/>
            </Canvas>

            <!-- ΝΕΟ - επέκταση για το πλευρικό μενού συντομεύσεων (SidebarNav/SidebarShortcuts.cs,
                 ορατό surface όταν SidebarEnabled=true, FontSize 24 - το ίδιο σπασμένο-emoji πρόβλημα). -->
            <Canvas x:Name="PartQuestion" Width="20" Height="20" Visibility="Collapsed">
                <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="17" Height="17" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="7.3,7.5" IsClosed="False">
                                <ArcSegment Point="10,6.3" Size="2.8,2.8" SweepDirection="Clockwise" IsLargeArc="False"/>
                                <ArcSegment Point="10,11" Size="2.8,2.8" SweepDirection="Clockwise" IsLargeArc="True"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
                <Ellipse Canvas.Left="9.1" Canvas.Top="13.3" Width="1.8" Height="1.8" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>

            <Canvas x:Name="PartClock" Width="20" Height="20" Visibility="Collapsed">
                <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="17" Height="17" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                <Line X1="10" Y1="10" X2="10" Y2="5" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Line X1="10" Y1="10" X2="13.5" Y2="10" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse Canvas.Left="9.2" Canvas.Top="9.2" Width="1.6" Height="1.6" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>

            <Canvas x:Name="PartDocument" Width="20" Height="20" Visibility="Collapsed">
                <Polygon Points="4,1.5 12.5,1.5 16,5 16,18.5 4,18.5" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"
                          StrokeLineJoin="Round" Fill="Transparent"/>
                <Polyline Points="12.5,1.5 12.5,5 16,5" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" Fill="Transparent"/>
                <Line X1="6.5" Y1="9" X2="13.5" Y2="9" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.1"/>
                <Line X1="6.5" Y1="12" X2="13.5" Y2="12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.1"/>
                <Line X1="6.5" Y1="15" X2="11" Y2="15" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.1"/>
            </Canvas>

            <Canvas x:Name="PartPuzzle" Width="20" Height="20" Visibility="Collapsed">
                <Path Fill="Transparent" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeLineJoin="Round">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="3,3" IsClosed="True">
                                <LineSegment Point="8,3"/>
                                <ArcSegment Point="12,3" Size="2,2" SweepDirection="Clockwise" IsLargeArc="True"/>
                                <LineSegment Point="17,3"/>
                                <LineSegment Point="17,8"/>
