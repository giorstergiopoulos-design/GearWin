<UserControl x:Class="OptimizerWpf.Views.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:OptimizerWpf.Views"
             xmlns:tr="clr-namespace:OptimizerWpf"
             mc:Ignorable="d">
    <!--
        Βελτιστοποίηση (Optimization) tab. Office Mode/Gaming Mode toggles are now a full port of
        Optimizer.ps1's Set-OfficeMode/Set-GamingMode (power plan + registry tweaks + Explorer restart
        on disable) - see PowerModeService.cs. Winget Updates Manager runs a real "winget upgrade"
        scan (see WingetService) and can upgrade selected packages.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="NestedScroll_PreviewMouseWheel">
        <StackPanel Margin="0,8,0,24">

            <!-- ΔΙΟΡΘΩΣΗ (χρήστης ξεκαθάρισε: "σου είπα το διαχειριστή ενημερώσεων λογισμικού πάνω
                 πάνω και μετά των οδηγών") - το αρχικό αίτημα ("πρώτα θα εμφανίζεις τον διαχειριστή
                 ενημερώσεων λογισμικού αμέσως μετά τις ενημερώσεις οδηγών") είχε παρερμηνευτεί ως
                 "Οδηγοί πρώτα, μετά Λογισμικό" - το σωστό νόημα ήταν "Λογισμικό ΠΡΩΤΑ (πάνω πάνω στην
                 καρτέλα), Οδηγοί αμέσως μετά". Τώρα πρώτη κάρτα της καρτέλας (καμία πάνω περιθώριο,
                 όπως κάθε πρώτη κάρτα εδώ) - η κάρτα Ενημερώσεων Οδηγών ακολουθεί αμέσως από κάτω. -->
            <TextBlock Text="{tr:Tr Opt_SectionUpdates}" Style="{StaticResource CardTitleStyle}" FontSize="15" Margin="4,0,0,8"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{tr:Tr Optimization_SoftwareUpdate}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtWingetStatus" Text="{tr:Tr Opt_WingetPrompt}" Style="{StaticResource SubTextStyle}" Margin="0,0,0,6"/>
                    <!-- ΝΕΟ (χρήστης ανέφερε: "δεν βλέπω progress bar"): ορατή μόνο όσο τρέχει σάρωση/
                         αναβάθμιση (IsIndeterminate - το winget CLI δεν εκθέτει πραγματικό ποσοστό
                         προόδου ανά αρχείο, μόνο τελικό exit code, οπότε ένα καθορισμένο 0-100% θα ήταν
                         ψεύτικο· η ασαφής/κυλιόμενη ("indeterminate") μπάρα δείχνει τίμια "σε εξέλιξη"
                         χωρίς να προσποιείται ακρίβεια που δεν υπάρχει). -->
                    <ProgressBar x:Name="ProgressWinget" Height="6" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,10"/>

                    <Border Background="{DynamicResource MainBgBrush}" CornerRadius="6" MinHeight="120" MaxHeight="320" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="NestedScroll_PreviewMouseWheel">
                            <ItemsControl x:Name="ListWingetUpdates">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Margin="4" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold">
                                                        <Run Text="{Binding Update.Name, Mode=OneWay}"/>
                                                        <Run Text=" [ "/>
                                                        <Run Text="{Binding Update.Id, Mode=OneWay}"/>
                                                        <Run Text=" ]"/>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource SubTextStyle}">
                                                        <Run Text="{tr:Tr Opt_CurrentVersion}"/>
                                                        <Run Text="{Binding Update.CurrentVersion, Mode=OneWay}"/>
                                                        <Run Text=" &#x2192; "/>
                                                        <Run Text="{tr:Tr Opt_NewVersion}"/>
                                                        <Run Text="{Binding Update.AvailableVersion, Mode=OneWay}"/>
                                                        <Run Text=" &#x00B7; "/>
                                                        <Run Text="{Binding Update.Source, Mode=OneWay}" FontStyle="Italic"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <!-- ΝΕΟ - roadmap "winget pin" - μόνο για πακέτα με πηγή winget (το "winget pin"
                                                     δεν έχει νόημα/δεν λειτουργεί για msstore/pip/npm/κ.λπ. πηγές). -->
                                                <Button Grid.Column="4" Click="BtnIgnoreUpdate_Click" Tag="{Binding}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                        Padding="16,4" Content="{tr:Tr Opt_IgnoreButton}" Style="{StaticResource FlatButtonStyle}"
                                                        AutomationProperties.Name="{tr:Tr Opt_IgnoreButton}"/>
                                                <Button Grid.Column="3" Click="BtnUninstallApp_Click" Tag="{Binding}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                        Padding="16,4" Content="{tr:Tr Opt_UninstallButton}" Style="{StaticResource FlatButtonStyle}"
                                                        AutomationProperties.Name="{tr:Tr Opt_UninstallButton}"/>
                                                <Button Grid.Column="2" Click="BtnPinWingetApp_Click" Tag="{Binding}" VerticalAlignment="Center"
                                                        Padding="16,4" Content="{tr:Tr Opt_PinAppButton}"
                                                        AutomationProperties.Name="{tr:Tr Opt_PinAppButton}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Update.Source}" Value="winget">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                    <Setter Property="Content" Value="{tr:Tr Opt_AppPinned}"/>
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- ΔΙΟΡΘΩΣΗ (χρήστης έστειλε screenshot: "πλάτυνε λίγο το κουμπί για τις ενημερώσεις
                         από το store και βάλε το κουμπί στην ίδια ευθεία με το σάρωση και αναβάθμιση
                         επιλεγμένων") - το BtnCheckMsStore μετακινήθηκε ΜΕΣΑ στο ίδιο Grid με τα δύο
                         άλλα κουμπιά (4η στήλη Auto) αντί για ξεχωριστή γραμμή από κάτω. Οι στήλες Auto
                         αυτοπροσαρμόζονται στο περιεχόμενό τους, οπότε ΔΕΝ επανέρχεται ο παλιός κίνδυνος
                         clipping σε μακρύτερες γλώσσες (π.χ. Γαλλικά) που είχε οδηγήσει στην αρχική
                         απόφαση για ξεχωριστή γραμμή με auto-size Padding (βλ. ιστορικό σχόλιο πιο κάτω) -
                         μια στήλη Auto είναι ΗΔΗ auto-size, απλά τώρα στην ίδια γραμμή. -->
                    <!-- Ρητό αίτημα χρήστη: "αντί για ένα απλό κουμπί, με έμπνευση από το κυκλικό των
                         οδηγών, φτιάξε ένα παρόμοιο με κινούμενο εικονίδιο αναβάθμισης εφαρμογών" - ίδιο
                         μοτίβο με το BtnScanDrivers/DriverScanButton παραπάνω στην κάρτα Οδηγών: μεγάλο
                         κυκλικό κουμπί σάρωσης αντί για το προηγούμενο απλό ορθογώνιο "Σάρωση". -->
                    <Button x:Name="BtnCancelAppScan" Content="{tr:Tr Cancel}" Style="{StaticResource FlatButtonStyle}" Padding="16,6" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" Click="BtnCancelAppScan_Click"/>
                    <views:AppUpdateScanButton x:Name="BtnScanWinget" HorizontalAlignment="Center" Margin="0,10,0,10" Click="BtnScanWinget_Click"/>
                    <!-- 6.8.0: ένα κουμπί που σαρώνει ταυτόχρονα εφαρμογές + Windows Update (ήδη στη λίστα εφαρμογών) + οδηγούς. -->
                    <Button x:Name="BtnScanAll" Content="{tr:Tr Opt_ScanAllBtn}" Style="{StaticResource FlatButtonStyle}" Padding="16,7"
                            HorizontalAlignment="Center" Margin="0,0,0,4" Click="BtnScanAll_Click"/>
                    <Button x:Name="BtnIgnored" Content="{tr:Tr Opt_IgnoredButton}" Style="{StaticResource FlatButtonStyle}" Padding="16,6" HorizontalAlignment="Center" Margin="0,0,0,6" Visibility="Collapsed" Click="BtnIgnored_Click"/>
                    <Button Content="{tr:Tr Opt_GitFolderBtn}" Style="{StaticResource FlatButtonStyle}" Padding="16,6" HorizontalAlignment="Center" Margin="0,0,0,6" Click="BtnAddGitFolder_Click"/>
                    <TextBlock Text="{tr:Tr Opt_ScanAllHint}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ChkSelectAll" Grid.Column="0" Content="{tr:Tr Opt_SelectAll}" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextBrush}" Click="ChkSelectAll_Click"/>
                        <!-- ΔΙΟΡΘΩΣΗ (χρήστης έδειξε με screenshot: "το ένα κουμπί έχει περιθώριο, στο
                             άλλο η περιγραφή είναι ίσα με το πλαίσιο") - Width="180" σταθερό εδώ ΚΑΙ
                             μόνο Padding (χωρίς κατώτατο όριο) στο BtnCheckMsStore δίπλα σημαίνει ότι
                             όταν ο 3-στηλος Grid στενεύει (λιγότερος χώρος από ό,τι χρειάζονται και τα
                             δύο κουμπιά μαζί με το checkbox), το Auto-στήλης BtnCheckMsStore συμπιέζεται
                             ΚΑΤΩ από το φυσικό του μέγεθος - το padding "καταπίνεται" οπτικά, ενώ αυτό
                             εδώ (σταθερό Width) δεν συμπιέζεται ποτέ κάτω από τα 180px. MinWidth αντί
                             για Width - ίδια προστασία, αλλά επιτρέπει να μεγαλώσει για πιο μακριές
                             μεταφράσεις αντί να κόβει/συμπιέζει το κείμενο. -->
                        <Button x:Name="BtnUpgradeSelected" Grid.Column="1" Content="{tr:Tr Opt_UpgradeSelected}" Style="{StaticResource AccentButtonStyle}" MinWidth="180" Margin="0,0,10,0" Click="BtnUpgradeSelected_Click"/>
                        <!-- Port του $global:btnCheckMsStore (ρητή ανάγκη - το "store updates" CLI
                             παραπάνω δεν πιάνει πάντα ΟΛΕΣ τις ενημερώσεις Metro/UWP εφαρμογών,
                             τεκμηριωμένο όριο - χρήστης ανέφερε "δεν φαίνονται οι ενημερώσεις των metro
                             εφαρμογών"). Ενεργοποιεί πραγματική σάρωση μέσω των επίσημων μηχανισμών των
                             Windows και ανοίγει το Store για επιβεβαίωση - συμπληρωματικό, όχι
                             υποκατάστατο της λίστας παραπάνω. Padding 24,10 διατηρείται ώστε το κείμενο
                             να έχει άνετο χώρο σε ΚΑΘΕ γλώσσα - ΚΑΙ τώρα MinWidth ώστε αυτό το padding
                             να ΜΗΝ μπορεί να συμπιεστεί κάτω από το ελάχιστο ασφαλές πλάτος όταν στενεύει
                             η στήλη (βλ. σχόλιο στο BtnUpgradeSelected παραπάνω για το ακριβές bug). -->
                        <Button x:Name="BtnCheckMsStore" Grid.Column="2" Content="{tr:Tr Opt_CheckMsStore}"
                                Style="{StaticResource AccentButtonStyle}" Height="40" Padding="24,10" MinWidth="300" Click="BtnCheckMsStore_Click"/>
                    </Grid>
                    <TextBlock Text="{tr:Tr Opt_MsStoreDesc}"
                            Style="{StaticResource SubTextStyle}" Margin="0,4,0,0"/>

                    <!-- ΝΕΟ - roadmap "νεότερες δυνατότητες winget στο UI" - "winget export/import":
                         αντιγραφή της λίστας εγκατεστημένων εφαρμογών (ID + έκδοση) σε νέο υπολογιστή,
                         βλ. WingetService.ExportAsync/ImportAsync. -->
                    <Separator Margin="0,12,0,10"/>
                    <TextBlock Text="{tr:Tr Opt_WingetPortableTitle}" Style="{StaticResource SubTextStyle}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnExportWingetList" Content="{tr:Tr Opt_ExportAppsListButton}" Style="{StaticResource FlatButtonStyle}" Padding="16,8" Margin="0,0,10,0" Click="BtnExportWingetList_Click"/>
                        <Button x:Name="BtnImportWingetList" Content="{tr:Tr Opt_ImportAppsListButton}" Style="{StaticResource FlatButtonStyle}" Padding="16,8" Click="BtnImportWingetList_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtWingetPortableStatus" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Ενημερώσεις Οδηγών Συσκευών - ενοποιημένη λειτουργία (ρητό αίτημα χρήστη: "οι δύο
                 ενημερώσεις οδηγών να ενσωματωθούν σε μια ενιαία λειτουργία"). Μία σάρωση ελέγχει ΚΑΙ
                 τις δύο πηγές: το επίσημο Windows Update (port του cardOpt4, ~11847) ΚΑΙ το Microsoft
                 Update Catalog ανά Hardware ID (βλ. HANDOFF.md §0.4ιε) - ένας ενιαίος κατάλογος
                 αποτελεσμάτων, κάθε γραμμή επισημαίνει την πηγή της. AMD/NVIDIA/Dell ΠΑΡΑΜΕΝΟΥΝ εκτός
                 εμβέλειας (web scraping/vendor tools συγκεκριμένα ανά κατασκευαστή, δεν καλύπτουν τη
                 γενική περίπτωση). ΣΗΜΕΙΩΣΗ ΕΙΛΙΚΡΙΝΕΙΑΣ: δεν γίνεται αξιόπιστη αποδιπλότυπηση ανάμεσα
                 στις δύο πηγές (διαφορετική μορφή αναγνώρισης συσκευής η καθεμία) - ενδέχεται να
                 εμφανιστεί ενημέρωση για την ίδια συσκευή και από τις δύο πηγές. -->
            <!-- Ρητό αίτημα χρήστη (screenshot της πραγματικής 2.8.2): μεγάλο κυκλικό κουμπί σάρωσης
                 (port του New-DriverScanButton, ~5555) αντί για απλό ορθογώνιο κουμπί - βλ.
                 DriverScanButton.xaml. Η λίστα αποτελεσμάτων μένει κρυφή μέχρι να υπάρξουν
                 αποτελέσματα (καθαρή "δεν έχει σαρωθεί ακόμα" κατάσταση, όπως στο screenshot). -->
            <!-- ΝΕΟ (πρόταση "χρονοδιάγραμμα ενημερώσεων"): βλ. AutoUpdateService - μόνο ενημερώσεις εφαρμογών winget, κάθε νύχτα 03:30. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <views:HeaderGlyphIcon Kind="Clock" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{tr:Tr Opt_NightlyUpdates}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{tr:Tr Opt_NightlyUpdatesDesc}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtNightlyUpdatesStatus" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="ToggleNightlyUpdates" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" Click="ToggleNightlyUpdates_Click"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{tr:Tr Opt_NightlyWindowsUpdates}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{tr:Tr Opt_NightlyWindowsUpdatesDesc}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="ToggleNightlyWindowsUpdates" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" Click="ToggleNightlyWindowsUpdates_Click"/>
                </Grid>
            </Border>

            <TextBlock Text="{tr:Tr Opt_SectionDrivers}" Style="{StaticResource CardTitleStyle}" FontSize="15" Margin="4,22,0,8"/>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <views:HeaderGlyphIcon Grid.Column="0" Kind="Package" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{tr:Tr Optimization_Drivers}" Style="{StaticResource CardTitleStyle}"/>
                    </Grid>
                    <TextBlock Text="{tr:Tr Opt_DriversDesc1}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap"/>
                    <TextBlock Text="{tr:Tr Opt_DriversDesc2}" FontStyle="Italic" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TxtDriverStatus" Text="" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <views:DriverScanButton x:Name="BtnScanDrivers" HorizontalAlignment="Center" Margin="0,16,0,10" Click="BtnScanDrivers_Click"/>
                    <Button x:Name="BtnCancelDriverScan" Content="{tr:Tr Cancel}" Style="{StaticResource FlatButtonStyle}" Padding="16,6" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed" Click="BtnCancelDriverScan_Click"/>
                    <TextBlock Text="{tr:Tr Opt_DriversScanHint}" Style="{StaticResource SubTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,4"/>

                    <Border x:Name="BorderDriverResults" Visibility="Collapsed" Background="{DynamicResource MainBgBrush}" CornerRadius="6" MinHeight="80" MaxHeight="280" Padding="4" Margin="0,10,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="NestedScroll_PreviewMouseWheel">
                            <ItemsControl x:Name="ListDriverUpdates">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Margin="4" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="6,1" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding SourceBadge}" FontSize="11" Foreground="White"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SubText}" Style="{StaticResource SubTextStyle}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{Binding ActionLabel}" Style="{StaticResource FlatButtonStyle}" VerticalAlignment="Center"
                                                        Click="BtnInstallDriver_Click" Tag="{Binding}" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Dell Command Update / SDIO / OEM (Lenovo/HP) - συνοπτικές, ξεχωριστές πηγές
                         (ΟΧΙ ανά-συσκευή γραμμές σαν τα παραπάνω) - port του Complete-DriverScan's Dell/
                         SDIO/OEM ενοτήτων. ΚΑΝΕΝΑ αυτόματο install - μόνο ανοίγει το επίσημο εργαλείο/
                         φάκελο αναφοράς, ο χρήστης αποφασίζει μέσα σε αυτό. -->
                    <TextBlock x:Name="TxtVendorExtra" Text="" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <StackPanel x:Name="PanelVendorExtraButtons" Orientation="Horizontal" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>


            <!-- Αντίγραφο Ασφαλείας Οδηγών - port του cardOpt5 (~13037). DISM Export-Driver/pnputil. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{tr:Tr Optimization_DriverBackup}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4"/>
                    <TextBlock Text="{tr:Tr Opt_DriverBackupDesc}" Style="{StaticResource SubTextStyle}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnDriverBackup" Content="{tr:Tr Opt_DriverBackupBtn}" Style="{StaticResource AccentButtonStyle}" Width="280" Height="40" Margin="0,0,10,0" Click="BtnDriverBackup_Click"/>
                        <Button x:Name="BtnDriverRestore" Content="{tr:Tr Opt_DriverRestoreBtn}" Style="{StaticResource FlatButtonStyle}" Width="280" Height="40" Click="BtnDriverRestore_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtDriverBackupStatus" Text="{tr:Tr Opt_ChooseAction}" Style="{StaticResource SubTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Καθαρισμός Αποθήκης Οδηγών - port του cardDriverStore (~13136). Get-WindowsDriver,
                 ομαδοποίηση κατά OriginalFileName, μόνο παλιότερες εκδόσεις προτείνονται προς διαγραφή. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{tr:Tr Optimization_DriverStore}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtDriverStoreStatus" Text="{tr:Tr Opt_DriverStoreDesc}" Style="{StaticResource SubTextStyle}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="ProgressDriverStore" Height="6" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource MainBgBrush}" CornerRadius="6" MinHeight="80" MaxHeight="280" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="NestedScroll_PreviewMouseWheel">
                            <ItemsControl x:Name="ListDriverStore">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Margin="4" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding OriginalFileName}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                                    <TextBlock Style="{StaticResource SubTextStyle}">
                                                        <Run Text="{Binding Version, Mode=OneWay}"/>
                                                        <Run Text=" &#x00B7; "/>
                                                        <Run Text="{Binding Date, Mode=OneWay}"/>
                                                        <Run Text=" &#x00B7; "/>
                                                        <Run Text="{Binding Class, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource SubTextStyle}" Text="{Binding KeptInfo, Mode=OneWay, StringFormat={}{0}}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{tr:Tr Opt_Delete}" Style="{StaticResource FlatButtonStyle}" VerticalAlignment="Center"
                                                        Click="BtnDeleteStoreDriver_Click" Tag="{Binding}" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Button x:Name="BtnScanDriverStore" Content="{tr:Tr Opt_ScanDriverStore}" Style="{StaticResource AccentButtonStyle}" Width="240"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Click="BtnScanDriverStore_Click"/>
                </StackPanel>
            </Border>

            <!-- ΕΝΟΠΟΙΗΣΗ (πρόταση "καλύτερη κατηγοριοποίηση/ομαδοποίηση"): οι 5 διαδοχικές κάρτες λειτουργίας (Office, Gaming,
                 Ultimate Performance, Αυτόματο Gaming, Προγραμματισμένη Συντήρηση) έγιναν ΜΙΑ κάρτα με γραμμές - ΙΔΙΑ ονόματα
                 στοιχείων/handlers/κλειδιά μετάφρασης, καμία αλλαγή λογικής. Το Gaming Mode μένει ως το μοναδικό "ένα κλικ"
                 κουμπί· οι αναλυτικές ρυθμίσεις παιχνιδιών (Game Mode/HAGS/VRR/προφίλ ανά παιχνίδι) ζουν στην καρτέλα Παιχνίδια
                 & Πολυμέσα και συνδέονται με το κουμπί στο τέλος. -->
            <TextBlock Text="{tr:Tr Opt_ModesSection}" Style="{StaticResource CardTitleStyle}" FontSize="15" Margin="4,22,0,8"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <views:HeaderGlyphIcon Kind="Gear" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{tr:Tr Optimization_OfficeMode}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{tr:Tr Opt_OfficeModeDesc}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleButton x:Name="ToggleOfficeMode" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" Click="ToggleOfficeMode_Click"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource CardBorderBrush}" Opacity="0.6" Margin="0,12,0,12"/>
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <views:HeaderGlyphIcon Kind="Gamepad" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{tr:Tr Optimization_GamingMode}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{tr:Tr Opt_GamingModeDesc}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtGamingModeStatus" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <CheckBox x:Name="ChkGamingFreeRam" Content="{tr:Tr Opt_GamingFreeRam}" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" Click="ChkGamingFreeRam_Click"/>
                            <TextBlock Text="{tr:Tr Opt_GamingFreeRamHint}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="22,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="BtnFreeRamNow" Content="{tr:Tr Opt_FreeRamNow}" Style="{StaticResource FlatButtonStyle}" Click="BtnFreeRamNow_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtFreeRamResult" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="ToggleGamingMode" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" Click="ToggleGamingMode_Click"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource CardBorderBrush}" Opacity="0.6" Margin="0,12,0,12"/>
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <views:HeaderGlyphIcon Kind="Bolt" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{tr:Tr Opt_UltimatePerformance}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{tr:Tr Opt_UltimatePerformanceDesc}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleButton x:Name="ToggleUltimatePerformance" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" Click="ToggleUltimatePerformance_Click"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource CardBorderBrush}" Opacity="0.6" Margin="0,12,0,12"/>
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <views:HeaderGlyphIcon Kind="Gamepad" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{tr:Tr Opt_AutoGamingMode}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{tr:Tr Opt_AutoGamingModeDesc}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleButton x:Name="ToggleAutoGamingMode" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" Click="ToggleAutoGamingMode_Click"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource CardBorderBrush}" Opacity="0.6" Margin="0,12,0,12"/>
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <views:HeaderGlyphIcon Kind="Clock" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{tr:Tr Opt_ScheduledMaintenance}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{tr:Tr Opt_ScheduledMaintenanceDesc}" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtScheduledMaintenanceStatus" Style="{StaticResource SubTextStyle}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="ToggleScheduledMaintenance" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" Click="ToggleScheduledMaintenance_Click"/>
                    </Grid>
                    <Button Content="{tr:Tr Opt_GamingDetailsLink}" Style="{StaticResource FlatButtonStyle}" Padding="16,6" HorizontalAlignment="Left" Margin="0,14,0,0" Click="BtnOpenGamesTab_Click"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
