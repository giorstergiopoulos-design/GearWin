<UserControl x:Class="OptimizerWpf.Views.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!--
        Βελτιστοποίηση (Optimization) tab. Office Mode/Gaming Mode toggles are now a full port of
        Optimizer.ps1's Set-OfficeMode/Set-GamingMode (power plan + registry tweaks + Explorer restart
        on disable) - see PowerModeService.cs. Winget Updates Manager runs a real "winget upgrade"
        scan (see WingetService) and can upgrade selected packages.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,24">

            <!-- Office Mode -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Office Mode &amp; Προφίλ Ενέργειας" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,6"/>
                        <TextBlock Text="Ισορροπημένη λειτουργία, περιορισμός περιττών οπτικών εφέ και διαφημίσεων." Style="{StaticResource SubTextStyle}"/>
                    </StackPanel>
                    <ToggleButton x:Name="ToggleOfficeMode" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}" Click="ToggleOfficeMode_Click"/>
                </Grid>
            </Border>

            <!-- Gaming Mode -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Gaming Mode &amp; Ultimate Performance" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,6"/>
                        <TextBlock Text="Μέγιστες επιδόσεις CPU/GPU, HAGS, Game DVR, Network Throttling off (VBS απενεργοποιείται προσωρινά)." Style="{StaticResource SubTextStyle}"/>
                    </StackPanel>
                    <ToggleButton x:Name="ToggleGamingMode" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}" Click="ToggleGamingMode_Click"/>
                </Grid>
            </Border>

            <!-- Winget Updates Manager -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Διαχειριστής Ενημερώσεων Λογισμικού" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtWingetStatus" Text="Πατήστε 'Σάρωση' για έλεγχο διαθέσιμων ενημερώσεων." Style="{StaticResource SubTextStyle}" Margin="0,0,0,6"/>
                    <!-- ΝΕΟ (χρήστης ανέφερε: "δεν βλέπω progress bar"): ορατή μόνο όσο τρέχει σάρωση/
                         αναβάθμιση (IsIndeterminate - το winget CLI δεν εκθέτει πραγματικό ποσοστό
                         προόδου ανά αρχείο, μόνο τελικό exit code, οπότε ένα καθορισμένο 0-100% θα ήταν
                         ψεύτικο· η ασαφής/κυλιόμενη ("indeterminate") μπάρα δείχνει τίμια "σε εξέλιξη"
                         χωρίς να προσποιείται ακρίβεια που δεν υπάρχει). -->
                    <ProgressBar x:Name="ProgressWinget" Height="6" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,10"/>

                    <Border Background="{DynamicResource MainBgBrush}" CornerRadius="6" MinHeight="120" MaxHeight="320" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ListWingetUpdates">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Margin="4" Padding="10">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel>
                                                    <TextBlock Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold">
                                                        <Run Text="{Binding Update.Name, Mode=OneWay}"/>
                                                        <Run Text=" [ "/>
                                                        <Run Text="{Binding Update.Id, Mode=OneWay}"/>
                                                        <Run Text=" ]"/>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource SubTextStyle}">
                                                        <Run Text="Τρέχουσα Έκδοση: "/>
                                                        <Run Text="{Binding Update.CurrentVersion, Mode=OneWay}"/>
                                                        <Run Text=" &#x2192; Νέα Έκδοση: "/>
                                                        <Run Text="{Binding Update.AvailableVersion, Mode=OneWay}"/>
                                                        <Run Text=" &#x00B7; "/>
                                                        <Run Text="{Binding Update.Source, Mode=OneWay}" FontStyle="Italic"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ChkSelectAll" Grid.Column="0" Content="Επιλογή Όλων" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextBrush}" Click="ChkSelectAll_Click"/>
                        <Button x:Name="BtnScanWinget" Grid.Column="1" Content="Σάρωση" Style="{StaticResource FlatButtonStyle}" Width="130" Margin="0,0,10,0" Click="BtnScanWinget_Click"/>
                        <Button x:Name="BtnUpgradeSelected" Grid.Column="2" Content="Αναβάθμιση Επιλεγμένων" Style="{StaticResource AccentButtonStyle}" Width="180" Click="BtnUpgradeSelected_Click"/>
                    </Grid>

                    <!-- Port του $global:btnCheckMsStore (ρητή ανάγκη - το "store updates" CLI παραπάνω
                         δεν πιάνει πάντα ΟΛΕΣ τις ενημερώσεις Metro/UWP εφαρμογών, τεκμηριωμένο όριο -
                         χρήστης ανέφερε "δεν φαίνονται οι ενημερώσεις των metro εφαρμογών"). Ενεργοποιεί
                         πραγματική σάρωση μέσω των επίσημων μηχανισμών των Windows και ανοίγει το Store
                         για επιβεβαίωση - συμπληρωματικό, όχι υποκατάστατο της λίστας παραπάνω. -->
                    <Button x:Name="BtnCheckMsStore" Content="Έλεγχος Ενημερώσεων μέσω Microsoft Store"
                            Style="{StaticResource FlatButtonStyle}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Padding="14,8" Click="BtnCheckMsStore_Click"/>
                    <TextBlock Text="Ενεργοποιεί πλήρη σάρωση ενημερώσεων μέσω των επίσημων μηχανισμών των Windows και ανοίγει το Microsoft Store για επιβεβαίωση - χρήσιμο αν κάποια ενημέρωση Metro/UWP εφαρμογής δεν εμφανίζεται στη λίστα παραπάνω."
                            Style="{StaticResource SubTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Ενημερώσεις Οδηγών Συσκευών - port του Optimizer.ps1's cardOpt4 (~11847). Windows
                 Update πηγή. AMD/NVIDIA/Dell ΠΑΡΑΜΕΝΟΥΝ εκτός εμβέλειας (web scraping/vendor tools
                 συγκεκριμένα ανά κατασκευαστή, δεν καλύπτουν τη γενική περίπτωση) - βλ. δεύτερη πηγή
                 (Microsoft Update Catalog) παρακάτω που καλύπτει τη γενική περίπτωση αντ' αυτών. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Ενημερώσεις Οδηγών Συσκευών (Windows Update)" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtDriverStatus" Text="Πατήστε 'Σάρωση' για έλεγχο ενημερώσεων οδηγών μέσω του επίσημου Windows Update." Style="{StaticResource SubTextStyle}" Margin="0,0,0,6"/>
                    <ProgressBar x:Name="ProgressDriver" Height="6" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource MainBgBrush}" CornerRadius="6" MinHeight="80" MaxHeight="280" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ListDriverUpdates">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Margin="4" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Style="{StaticResource SubTextStyle}">
                                                        <Run Text="{Binding Manufacturer, Mode=OneWay}"/>
                                                        <Run Text=" &#x00B7; "/>
                                                        <Run Text="{Binding DriverClass, Mode=OneWay}"/>
                                                        <Run Text=" &#x00B7; "/>
                                                        <Run Text="{Binding Date, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Εγκατάσταση" Style="{StaticResource FlatButtonStyle}" VerticalAlignment="Center"
                                                        Click="BtnInstallDriver_Click" Tag="{Binding}" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Button x:Name="BtnScanDrivers" Content="Σάρωση Ενημερώσεων Οδηγών" Style="{StaticResource AccentButtonStyle}" Width="260"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Click="BtnScanDrivers_Click"/>
                </StackPanel>
            </Border>

            <!-- Ενημερώσεις Οδηγών - Microsoft Update Catalog (νέα, δεύτερη πηγή, ρητό αίτημα χρήστη
                 μετά από αξιολόγηση του Driver_Updater.ps1 - βλ. HANDOFF.md §0.4ιε). Αναζήτηση ανά
                 Hardware ID σε ΟΛΕΣ τις συσκευές, όχι μόνο ό,τι η WU θεωρεί επιλέξιμο. Throttled +
                 sanity-checked - βλ. DriverService.ScanCatalogAsync. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Ενημερώσεις Οδηγών - Microsoft Update Catalog" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtCatalogStatus" Text="Αναζητά ενημερώσεις ανά Hardware ID για κάθε συσκευή απευθείας στο Microsoft Update Catalog - μπορεί να διαρκέσει αρκετά λεπτά για πολλές συσκευές." Style="{StaticResource SubTextStyle}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="ProgressCatalog" Height="6" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource MainBgBrush}" CornerRadius="6" MinHeight="80" MaxHeight="280" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ListCatalogUpdates">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Margin="4" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Style="{StaticResource SubTextStyle}">
                                                        <Run Text="{Binding DeviceName, Mode=OneWay}"/>
                                                        <Run Text=" &#x00B7; v"/>
                                                        <Run Text="{Binding Version, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Εγκατάσταση" Style="{StaticResource FlatButtonStyle}" VerticalAlignment="Center"
                                                        Click="BtnInstallCatalogDriver_Click" Tag="{Binding}" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Button x:Name="BtnScanCatalog" Content="Σάρωση Microsoft Update Catalog" Style="{StaticResource AccentButtonStyle}" Width="280"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Click="BtnScanCatalog_Click"/>
                </StackPanel>
            </Border>

            <!-- Αντίγραφο Ασφαλείας Οδηγών - port του cardOpt5 (~13037). DISM Export-Driver/pnputil. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Αντίγραφο Ασφαλείας Οδηγών Συστήματος" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4"/>
                    <TextBlock Text="Δημιουργεί αντίγραφο ασφαλείας όλων των οδηγών τρίτων κατασκευαστών σε φάκελο της επιλογής σας. Χρήσιμο πριν από επανεγκατάσταση Windows." Style="{StaticResource SubTextStyle}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnDriverBackup" Content="Δημιουργία Αντιγράφου Ασφαλείας" Style="{StaticResource AccentButtonStyle}" Width="280" Margin="0,0,10,0" Click="BtnDriverBackup_Click"/>
                        <Button x:Name="BtnDriverRestore" Content="Επαναφορά Οδηγών από Αντίγραφο" Style="{StaticResource FlatButtonStyle}" Width="280" Click="BtnDriverRestore_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtDriverBackupStatus" Text="Επιλέξτε ενέργεια." Style="{StaticResource SubTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Καθαρισμός Αποθήκης Οδηγών - port του cardDriverStore (~13136). Get-WindowsDriver,
                 ομαδοποίηση κατά OriginalFileName, μόνο παλιότερες εκδόσεις προτείνονται προς διαγραφή. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Καθαρισμός Αποθήκης Οδηγών &amp; Αναφορά" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtDriverStoreStatus" Text="Εντοπίζει παλιότερες, διπλότυπες εκδόσεις οδηγών τρίτων κατασκευαστών - πατήστε 'Σάρωση' για ανάλυση." Style="{StaticResource SubTextStyle}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="ProgressDriverStore" Height="6" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource MainBgBrush}" CornerRadius="6" MinHeight="80" MaxHeight="280" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ListDriverStore">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Margin="4" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding OriginalFileName}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                                    <TextBlock Style="{StaticResource SubTextStyle}">
                                                        <Run Text="{Binding Version, Mode=OneWay}"/>
                                                        <Run Text=" &#x00B7; "/>
                                                        <Run Text="{Binding Date, Mode=OneWay}"/>
                                                        <Run Text=" &#x00B7; "/>
                                                        <Run Text="{Binding Class, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Διαγραφή" Style="{StaticResource FlatButtonStyle}" VerticalAlignment="Center"
                                                        Click="BtnDeleteStoreDriver_Click" Tag="{Binding}" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Button x:Name="BtnScanDriverStore" Content="Σάρωση Αποθήκης Οδηγών" Style="{StaticResource AccentButtonStyle}" Width="240"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Click="BtnScanDriverStore_Click"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
