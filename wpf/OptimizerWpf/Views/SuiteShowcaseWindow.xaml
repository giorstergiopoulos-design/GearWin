<Window x:Class="OptimizerWpf.Views.SuiteShowcaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tr="clr-namespace:OptimizerWpf"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" KeyDown="Window_KeyDown"
        AutomationProperties.Name="The Opsis family">
    <!-- 6.6.0 - «Η οικογένεια Opsis»: μία κάρτα ανά εφαρμογή της σουίτας (κινούμενο εικονίδιο, περιγραφή, δυνατότητες, κατάσταση
         εγκατάστασης, Άνοιγμα / Εγκατάσταση / Λεπτομέρειες). Ίδια κουρτίνα και ίδιο εφέ σμίκρυνσης με τον οδηγό καλωσορίσματος. -->
    <Grid>
        <Border x:Name="Backdrop" Background="{DynamicResource MainBgBrush}" Opacity="0.95"/>
        <Border x:Name="Card" Background="{DynamicResource CardBgBrush}" CornerRadius="{DynamicResource AppCornerRadius}"
                MaxWidth="1120" Margin="16" Padding="22,18,22,16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{tr:Tr Suite_Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{tr:Tr Suite_Subtitle}" FontSize="13" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnClose" Grid.Column="1" Content="{tr:Tr Suite_Close}" Style="{StaticResource AccentButtonStyle}" Padding="18,7"
                            VerticalAlignment="Top" Margin="12,0,0,0" Click="BtnClose_Click"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="CardsPanel" HorizontalAlignment="Center"/>
                </ScrollViewer>
                <TextBlock x:Name="TxtNote" Grid.Row="2" FontSize="11" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
