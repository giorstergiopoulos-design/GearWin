        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MainBgBrush}">
    <!-- Ρητό αίτημα χρήστη: "η βοήθεια δεν κάνει αναφορά ούτε σε όλες τις καρτέλες ούτε σε όλες τις
         λειτουργίες" - ξαναγράφτηκε με ΞΕΧΩΡΙΣΤΗ ενότητα ανά μία από τις 8 καρτέλες (πριν, 6 από αυτές
         ήταν στριμωγμένες σε ΜΙΑ γενική παράγραφο), κάθε μία απαριθμώντας τα πραγματικά εργαλεία/
         λειτουργίες που περιέχει - όχι πλέον μόνο γενικές περιγραφές.
         ΔΙΟΡΘΩΣΗ (χρήστης ζήτησε: "στην Βοήθεια/Οδηγίες να ανοίγει το παράθυρο με δύο tabs όπου το
         δεύτερο θα είναι η άδεια χρήσης, δεν θέλω επιπλέον tab στο σύγχρονο μενού") - η Άδεια Χρήσης
         είχε αρχικά προστεθεί ως δικό της παράθυρο (LicenseWindow, αφαιρέθηκε) ΚΑΙ ως ξεχωριστή
         συντόμευση στο SidebarShortcuts (αφαιρέθηκε επίσης) - τώρα ζει ΜΟΝΟ ως 2ο tab εδώ, ίδιο
         μοτίβο TabControl/PillTabItemStyle με το AppearanceSettingsWindow. Το κλασικό μενού's "Άδεια
         Χρήσης" άνοιγμα ανοίγει πλέον αυτό το ίδιο παράθυρο με initialTabIndex:1 (βλ.
         MainWindow.xaml.cs's OpenDestination). -->
    <!-- ΔΙΟΡΘΩΣΗ (χρήστης ζήτησε: "βγάλε από τα δευτερεύοντα παράθυρα το κινούμενο φόντο") - τα
         δευτερεύοντα παράθυρα (Βοήθεια, Ιστορικό, Ρυθμίσεις Εμφάνισης, ViVeTool, UWP Manager,
         Ιστορικό Ενεργειών) δεν έχουν πια δικό τους ThemedBackgroundControl/DispatcherTimer - μόνο
         το κύριο παράθυρο (και η οθόνη εκκίνησης) διατηρούν κινούμενο φόντο. Λιγότερα ταυτόχρονα
         animation timers όποτε είναι ανοιχτό κάποιο από αυτά τα παράθυρα. -->
    <Grid>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="MainTabs" Grid.Row="0" Padding="4,4,0,0" Background="{DynamicResource TabBgBrush}" BorderThickness="0" ItemContainerStyle="{StaticResource PillTabItemStyle}">
