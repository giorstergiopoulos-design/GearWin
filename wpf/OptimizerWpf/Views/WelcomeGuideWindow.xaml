<Window x:Class="OptimizerWpf.Views.WelcomeGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tr="clr-namespace:OptimizerWpf"
        xmlns:views="clr-namespace:OptimizerWpf.Views"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" KeyDown="Window_KeyDown"
        AutomationProperties.Name="Welcome guide">
    <!-- 6.6.0 - οδηγός καλωσορίσματος (4-6 σελίδες) που εμφανίζεται μία φορά ανά νέα έκδοση major.minor και από τη Βοήθεια/tray.
         Καλύπτει το περιεχόμενο του κύριου παραθύρου όπως η κουρτίνα εκκίνησης· στο κλείσιμο η κάρτα σμικρύνεται μέσα στο εικονίδιο του
         παραθύρου (βλ. OverlayCardHost). Δεν μπλοκάρει την εφαρμογή: οι σαρώσεις συνεχίζουν πίσω από αυτόν. -->
    <Grid>
        <Border x:Name="Backdrop" Background="{DynamicResource MainBgBrush}" Opacity="0.93" MouseLeftButtonDown="Backdrop_Click"/>
        <Border x:Name="Card" Background="{DynamicResource CardBgBrush}" CornerRadius="{DynamicResource AppCornerRadius}"
                MaxWidth="660" MinWidth="320" Padding="30,24,30,20" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Border x:Name="IconBorder" Width="76" Height="76" CornerRadius="18" Background="{DynamicResource AccentBrush}"
                            RenderTransformOrigin="0.5,0.5" Margin="0,0,16,0">
                        <Border.RenderTransform><ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <views:ThreeGearIcon Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GearWin" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="TxtVersion" FontSize="13" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"/>
                        <TextBlock Text="{tr:Tr Guide_Welcome}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" MinHeight="190" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtDesc" FontSize="14" Foreground="{DynamicResource SubTextBrush}" LineHeight="21" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center"/>
                    <Button x:Name="BtnFamily" Content="{tr:Tr Guide_MeetFamily}" Style="{StaticResource FlatButtonStyle}" Padding="16,7"
                            HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed" Click="BtnFamily_Click"/>
                </StackPanel>

                <StackPanel x:Name="DotsPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,12"/>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <CheckBox x:Name="ChkDontShow" IsChecked="True" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{tr:Tr Guide_DontShow}" TextWrapping="Wrap"/>
                        </CheckBox>
                        <Button x:Name="BtnSkip" Content="{tr:Tr Guide_Skip}" Style="{StaticResource FlatButtonStyle}" Padding="12,4"
                                HorizontalAlignment="Left" Margin="0,6,0,0" Click="BtnSkip_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnBack" Content="{tr:Tr Guide_Back}" Style="{StaticResource FlatButtonStyle}" Padding="16,8" Margin="0,0,8,0" Click="BtnBack_Click"/>
                        <Button x:Name="BtnNext" Content="{tr:Tr Guide_Next}" Style="{StaticResource AccentButtonStyle}" Padding="20,8" Click="BtnNext_Click"/>
                        <Button x:Name="BtnFinish" Content="{tr:Tr Guide_Finish}" Style="{StaticResource AccentButtonStyle}" Padding="20,8" Click="BtnFinish_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
